<Window x:Class="MDM.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bilgi" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI" ShowInTaskbar="False">

    <Border Background="#1B1B1B" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#222222" CornerRadius="12,12,0,0" ClipToBounds="True"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock x:Name="TxtTitle" Text="Bilgi" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                    <Button HorizontalAlignment="Right" Width="36" Height="32" Content="✕"
                            Cursor="Hand" Click="BtnOk_Click" FontSize="11"
                            Foreground="#AAA" BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,11,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,12,16,4">
                <TextBlock x:Name="TxtMessage" Text="" TextWrapping="Wrap"
                           FontSize="13" FontWeight="SemiBold" Foreground="#EEEEEE" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtDetail" Text="" TextWrapping="Wrap"
                           FontSize="11" Foreground="#888888" LineHeight="16"/>
                <Border x:Name="PathPanel" Visibility="Collapsed" Margin="0,10,0,0"
                        Background="#141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPath" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Foreground="#E0E0E0" FontSize="11" FontFamily="Consolas" Padding="10,8"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="72"
                                 Cursor="IBeam"/>
                        <Button x:Name="BtnCopyPath" Grid.Column="1" Content="Kopyala" Margin="0,6,8,6"
                                Padding="10,0" MinWidth="72" Height="28" Click="BtnCopyPath_Click"
                                Cursor="Hand" FontSize="11" Foreground="#E8E8E8" BorderThickness="0" Background="#2A2A2A">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2A2A2A" CornerRadius="6" Padding="10,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,14">
                <Button x:Name="BtnOk" Content="Tamam" Width="78" Height="28" Cursor="Hand" Click="BtnOk_Click"
                        FontSize="12" FontWeight="SemiBold" Foreground="White" BorderThickness="0" IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#FF6B00" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
