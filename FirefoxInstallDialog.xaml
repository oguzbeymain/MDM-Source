<Window x:Class="MDM.FirefoxInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firefox eklentisi" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI" ShowInTaskbar="False">

    <Border Background="#1B1B1B" BorderBrush="#333333" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#222222" CornerRadius="12,12,0,0" ClipToBounds="True"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock x:Name="TxtTitleBar" Text="Firefox eklentisi" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                    <Button HorizontalAlignment="Right" Width="36" Height="32" Content="✕"
                            Cursor="Hand" Click="BtnCancel_Click" FontSize="11"
                            Foreground="#AAA" BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,11,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,14,18,6">
                <TextBlock x:Name="TxtHeader" Text="Kurulum seçimi" FontSize="14" FontWeight="SemiBold"
                           Foreground="#EEEEEE" Margin="0,0,0,10"/>

                <Border Background="#241C14" BorderBrush="#5A3A18" BorderThickness="1"
                        CornerRadius="10" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtTempHead" Text="Geçici kurulum (normal Firefox)" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FFB74D" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTempBody" TextWrapping="Wrap" FontSize="11" Foreground="#B0B0B0" LineHeight="16"
                                   Text="Bu oturumda çalışır. Firefox’u kapatınca eklenti silinir — tekrar kurman gerekir. Mozilla, normal Firefox’ta imzasız eklentiyi kalıcı tutmaya izin vermez."/>
                    </StackPanel>
                </Border>

                <Border Background="#141C18" BorderBrush="#2A4A34" BorderThickness="1"
                        CornerRadius="10" Padding="12" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock x:Name="TxtPermHead" Text="Kalıcı kurulum (önerilen)" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#8BC34A" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtPermBody" TextWrapping="Wrap" FontSize="11" Foreground="#B0B0B0" LineHeight="16"
                                   Text="Firefox Developer Edition kurarsan eklenti Eklentiler listesinde kalır ve yeniden açılışta da çalışır. Kurduktan sonra MDM’de tekrar «Firefox otomatik kur»a bas."/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="18,8,18,16">
                <Button x:Name="BtnDevEdition" Height="34" Cursor="Hand" Click="BtnDevEdition_Click"
                        FontSize="12" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                        Margin="0,0,0,8" HorizontalContentAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2E7D32" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#388E3C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="TxtDevBtn" Text="Firefox Developer Edition’ı indir / aç"/>
                </Button>

                <Button x:Name="BtnTemporary" Height="34" Cursor="Hand" Click="BtnTemporary_Click"
                        FontSize="12" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                        Margin="0,0,0,8" IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#FF6B00" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="TxtTempBtn" Text="Geçici kur (bu oturum)"/>
                </Button>

                <Button x:Name="BtnCancel" Content="Vazgeç" Height="30" Cursor="Hand" Click="BtnCancel_Click"
                        FontSize="12" Foreground="#CCC" BorderThickness="0" HorizontalAlignment="Right"
                        Padding="16,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
