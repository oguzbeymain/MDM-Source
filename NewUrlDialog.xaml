<Window x:Class="DownloadMuck.NewUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni indirme" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=TxtUrl}">
    <!-- DropShadow yok — köşe taşması olmasın -->
    <Border x:Name="DlgChrome" Background="#1B1B1B" BorderBrush="#333" BorderThickness="1" CornerRadius="12" Margin="0">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
                <Button x:Name="BtnCloseX" DockPanel.Dock="Right" Content="✕" Width="32" Height="32"
                        Click="BtnClose_Click" Cursor="Hand" Foreground="#888888" BorderThickness="0"
                        FontSize="12" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#C62828"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitleIcon" Text="🔗" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="Yeni indirme" FontWeight="SemiBold" FontSize="14" Foreground="#EEE"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="TxtHint" Grid.Row="1" Text="HTTP, FTP, SFTP, metalink, torrent veya magnet yapıştırın. Birden fazla adres, Ctrl+Enter. Sayfa taramak için ‘Sayfayı tara’."
                       Foreground="#888" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <Border x:Name="UrlBox" Grid.Row="2" Background="#252525" BorderBrush="#FF6B00" BorderThickness="1"
                    CornerRadius="8" MinHeight="88">
                <Grid>
                    <TextBlock x:Name="TxtPlaceholder" Text="https://..." Foreground="#555" Margin="12,8,0,0"
                               VerticalAlignment="Top" FontSize="12" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtUrl}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="TxtUrl" Background="Transparent" BorderThickness="0"
                             Foreground="White" CaretBrush="#FF6B00" FontSize="13"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="80" Padding="12,8"
                             KeyDown="TxtUrl_KeyDown" TextChanged="TxtUrl_TextChanged"/>
                </Grid>
            </Border>

            <StackPanel x:Name="BtnRow" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="BtnTorrent" Content="Torrent dosyası" MinWidth="108" Height="32" Margin="0,0,8,0" Padding="12,0"
                        Click="BtnBrowseTorrent_Click" Cursor="Hand" Foreground="#CCC" BorderThickness="0" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2D2D2D" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnCancel" Content="İptal" MinWidth="84" Height="32" Margin="0,0,8,0" Padding="14,0"
                        Click="BtnClose_Click" Cursor="Hand" Foreground="#CCC" BorderThickness="0" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2D2D2D" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnGrab" Content="Sayfayı tara" MinWidth="96" Height="32" Margin="0,0,8,0" Padding="14,0"
                        Click="BtnGrab_Click" Cursor="Hand" Foreground="#CCC" BorderThickness="0" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2D2D2D" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="İndir" MinWidth="84" Height="32" Padding="14,0" Click="BtnDownload_Click"
                        Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#FF6B00" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
