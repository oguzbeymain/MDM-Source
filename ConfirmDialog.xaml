<Window x:Class="MDM.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onay" Height="168" Width="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI" ShowInTaskbar="False"
        SizeToContent="Height">

    <Border x:Name="DlgChrome" Background="#1B1B1B" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="DlgTitleBar" Grid.Row="0" Background="#222222" CornerRadius="12,12,0,0" ClipToBounds="True"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock x:Name="TxtTitle" Text="Onay" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                    <Button HorizontalAlignment="Right" Width="36" Height="32" Content="✕"
                            Cursor="Hand" Click="BtnCancel_Click" FontSize="11"
                            Foreground="#AAA" BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,11,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,12,16,4">
                <TextBlock x:Name="TxtMessage" Text="" TextWrapping="Wrap"
                           FontSize="13" FontWeight="SemiBold" Foreground="#EEEEEE" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtDetail" Text="" TextWrapping="Wrap"
                           FontSize="11" Foreground="#888888" LineHeight="16"/>
            </StackPanel>

            <StackPanel x:Name="DlgFooter" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="16,8,16,14">
                <Button Content="İptal" x:Name="BtnCancelLabel" Width="78" Height="28" Margin="0,0,8,0"
                        Cursor="Hand" Click="BtnCancel_Click" FontSize="12"
                        Foreground="#DDD" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2A2A2A" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                    <Setter Property="Foreground" Value="#FFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnConfirm" Content="Onayla" MinWidth="72" Height="28" Padding="12,0" Cursor="Hand" Click="BtnConfirm_Click"
                        FontSize="12" FontWeight="SemiBold" Foreground="White" BorderThickness="0"
                        Background="#C62828" FocusVisualStyle="{x:Null}" IsTabStop="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
