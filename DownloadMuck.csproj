<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.6</Version>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <FileVersion>1.0.6.0</FileVersion>
    <InformationalVersion>1.0.6</InformationalVersion>
    <Product>MDM</Product>
    <AssemblyTitle>DownloadMuck</AssemblyTitle>
    <DefaultItemExcludes>$(DefaultItemExcludes);MDM.Updater\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="MDM.Updater\**" />
    <Page Remove="MDM.Updater\**" />
    <EmbeddedResource Remove="MDM.Updater\**" />
    <None Remove="MDM.Updater\**" />
  </ItemGroup>
</Project>