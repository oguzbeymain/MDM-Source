{
  "manifest_version": 3,
  "name": "DownloadMuck Integration",
  "version": "1.4",
  "description": "DownloadMuck / MDM masaustu indirme yoneticisi entegrasyonu",
  "permissions": [
    "downloads",
    "downloads.shelf",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:18680/*",
    "http://127.0.0.1:18681/*",
    "http://127.0.0.1:18682/*",
    "http://127.0.0.1:18700/*",
    "http://127.0.0.1:27182/*",
    "http://127.0.0.1:38472/*",
    "http://127.0.0.1:6800/*",
    "http://localhost:18680/*",
    "http://localhost:18681/*",
    "http://localhost:18682/*",
    "http://localhost:18700/*",
    "http://localhost:27182/*",
    "http://localhost:38472/*",
    "http://localhost:6800/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
