{
  "manifest_version": 3,
  "name": "DownloadMuck Integration",
  "version": "1.2",
  "description": "DownloadMuck / MDM masaustu indirme yoneticisi entegrasyonu",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:6800/*",
    "http://localhost:6800/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
