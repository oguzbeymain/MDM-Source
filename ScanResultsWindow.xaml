<Window x:Class="MDM.ScanResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MDM"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Sayfa taraması" Height="660" Width="920"
        MinHeight="480" MinWidth="720"
        Background="#121212" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
        AllowsTransparency="False" ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/mdm.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#121212"/>
        <SolidColorBrush x:Key="CardDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="InputDark" Color="#262626"/>
        <SolidColorBrush x:Key="ScanText" Color="#E4E4E4"/>
        <SolidColorBrush x:Key="ScanMuted" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="ScanLine" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ScanChipBg" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="ScanChipBorder" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="ScanChipFg" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="ScanChipHoverBorder" Color="#454545"/>
        <SolidColorBrush x:Key="ScanRowHover" Color="#232323"/>
        <SolidColorBrush x:Key="ScanThumbBg" Color="#161616"/>
        <SolidColorBrush x:Key="ScanSoftBg" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ScanSoftHover" Color="#353535"/>
        <SolidColorBrush x:Key="ScanSoftFg" Color="#D0D0D0"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Modern koyu scrollbar -->
        <Style x:Key="ScanScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb" Background="#3A3A3A" CornerRadius="4" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#FF6B00"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#FF8533"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScanScrollPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScanScrollPageButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScanScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScanScrollPageButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seçim kutusu -->
        <Style x:Key="ScanCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ScanText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="17" Height="17" CornerRadius="4.5"
                                    Background="{DynamicResource CheckBoxIdleBgBrush}"
                                    BorderBrush="{DynamicResource CheckBoxIdleBorderBrush}"
                                    BorderThickness="1.2" SnapsToDevicePixels="True"
                                    VerticalAlignment="Center">
                                <Viewbox Width="11" Height="11" Stretch="Uniform">
                                    <Path x:Name="mark" Data="M3.5,8.5 L6.8,11.8 L13.2,5.2"
                                          Stroke="{DynamicResource CheckBoxMarkBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Viewbox>
                            </Border>
                            <ContentPresenter x:Name="label" Margin="8,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource CheckBoxCheckedFillBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tür filtresi çipi -->
        <Style x:Key="ScanFilterChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ScanChipFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="chip" Background="{DynamicResource ScanChipBg}"
                                BorderBrush="{DynamicResource ScanChipBorder}" BorderThickness="1"
                                CornerRadius="9" Padding="12,6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FF8533"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource ScanChipHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="chip" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScanSoftButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{DynamicResource ScanSoftFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource ScanSoftBg}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ScanSoftHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScanAccentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FF6B00" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bulunan dosya satırı — ContextMenu kodda açılır (Separator/stil hatası yok) -->
        <Style x:Key="ScanItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ScanItem_PreviewMouseRightButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" CornerRadius="10" Padding="10,7"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource ScanRowHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ScanRoot" Background="{DynamicResource BgDark}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Border x:Name="ScanTitleBar" Background="#181818" BorderBrush="{DynamicResource ScanLine}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/mdm-logo.png" Width="18" Height="18"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TxtScanTitle" Grid.Column="1" Text="Sayfa taraması" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{DynamicResource ScanText}"/>
                    <TextBlock x:Name="TxtScanPage" Grid.Column="2" Text="" Margin="14,0,12,0"
                               VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ScanMuted}"/>
                    <Button x:Name="BtnScanClose" Grid.Column="3" Width="44" Height="42" Content="✕"
                            Click="BtnClose_Click" Cursor="Hand" FontSize="12" Foreground="#999"
                            BorderThickness="0" Background="Transparent"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Tür filtreleri -->
            <Border Grid.Row="1" x:Name="ScanFilterBar" Background="{DynamicResource BgDark}" Padding="16,12,16,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtScanFilterLabel" Text="Aranacak dosya türleri" FontSize="11.5"
                               Foreground="{DynamicResource ScanMuted}" Margin="0,0,0,8"/>
                    <WrapPanel Grid.Row="1" x:Name="PanelChips">
                        <ToggleButton x:Name="ChipAll" Style="{StaticResource ScanFilterChip}" Content="Tümü"
                                      Checked="ChipAll_Changed" Unchecked="ChipAll_Changed"/>
                        <ToggleButton x:Name="ChipImage" Style="{StaticResource ScanFilterChip}" Content="Resimler"
                                      Checked="Chip_Changed" Unchecked="Chip_Changed" Tag="Image"/>
                        <ToggleButton x:Name="ChipVideo" Style="{StaticResource ScanFilterChip}" Content="Videolar"
                                      Checked="Chip_Changed" Unchecked="Chip_Changed" Tag="Video"/>
                        <ToggleButton x:Name="ChipAudio" Style="{StaticResource ScanFilterChip}" Content="Sesler"
                                      Checked="Chip_Changed" Unchecked="Chip_Changed" Tag="Audio"/>
                        <ToggleButton x:Name="ChipArchive" Style="{StaticResource ScanFilterChip}" Content="Arşivler"
                                      Checked="Chip_Changed" Unchecked="Chip_Changed" Tag="Archive"/>
                        <ToggleButton x:Name="ChipDocument" Style="{StaticResource ScanFilterChip}" Content="Dökümanlar"
                                      Checked="Chip_Changed" Unchecked="Chip_Changed" Tag="Document"/>
                        <ToggleButton x:Name="ChipApp" Style="{StaticResource ScanFilterChip}" Content="Uygulamalar"
                                      Checked="Chip_Changed" Unchecked="Chip_Changed" Tag="App"/>
                        <ToggleButton x:Name="ChipOther" Style="{StaticResource ScanFilterChip}" Content="Diğer"
                                      Checked="Chip_Changed" Unchecked="Chip_Changed" Tag="Other"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Liste -->
            <Border Grid.Row="2" x:Name="ScanListPanel" Background="{DynamicResource CardDark}"
                    BorderBrush="{DynamicResource ScanLine}" BorderThickness="1" CornerRadius="12"
                    Margin="16,10,16,0">
                <Grid>
                    <ListBox x:Name="LstItems" Background="Transparent" BorderThickness="0" Padding="8,8,4,8"
                             ItemContainerStyle="{StaticResource ScanItemContainer}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="LstItems_MouseDoubleClick"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Style="{StaticResource ScanCheckBox}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>

                                    <Border Grid.Column="1" Width="44" Height="34" Margin="12,0,0,0"
                                            CornerRadius="7" Background="{DynamicResource ScanThumbBg}"
                                            BorderBrush="{DynamicResource ScanLine}" BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding ExtDisplay}" FontSize="9.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ScanMuted}"/>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVis}}"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ScanText}"/>
                                        <TextBlock Text="{Binding Url}" FontSize="10.5" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ScanMuted}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontSize="11.5"
                                               MinWidth="74" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ScanMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,10,6,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="#FF8533" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ItemCount}" FontSize="11"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ScanMuted}"/>
                                            <Border Grid.Column="2" Height="1" Margin="12,1,12,0"
                                                    Background="{DynamicResource ScanLine}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="{DynamicResource ScanGroupSelectText}"
                                                    FontSize="10.5" Height="24"
                                                    Padding="10,0" Style="{StaticResource ScanSoftButton}"
                                                    Click="GroupSelect_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <TextBlock x:Name="TxtScanEmpty" Text="Sayfada indirilebilir dosya bulunamadı."
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource ScanMuted}" Visibility="Collapsed"/>

                    <Border x:Name="ScanBusyOverlay" Background="#CC1E1E1E" CornerRadius="11">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtScanBusy" Text="Taranıyor…" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource ScanText}"/>
                            <ProgressBar x:Name="ScanBusyBar" Width="180" Height="4" Margin="0,12,0,0"
                                         IsIndeterminate="True" Background="Transparent" BorderThickness="0"
                                         Foreground="#FF6B00"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Alt bar -->
            <Border Grid.Row="3" x:Name="ScanFooter" Background="{DynamicResource BgDark}" Padding="16,12,16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="ChkSelectAll" Style="{StaticResource ScanCheckBox}" Content="Tümünü seç"
                              VerticalAlignment="Center" Click="ChkSelectAll_Click"/>

                    <TextBlock x:Name="TxtScanSummary" Grid.Column="1" Text="" Margin="16,0,16,0"
                               VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource ScanMuted}" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnScanCancel" Content="İptal" MinWidth="92" Margin="0,0,8,0"
                                Style="{StaticResource ScanSoftButton}" Click="BtnClose_Click"/>
                        <Button x:Name="BtnScanDownload" Content="Seçilenleri indir" MinWidth="150"
                                Style="{StaticResource ScanAccentButton}" Click="BtnDownload_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
