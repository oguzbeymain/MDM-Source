                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="Görünüm" Tag="▦" ItemContainerStyle="{StaticResource EmptySubmenuLeafStyle}">
                <MenuItem x:Name="MenuViewSmall" Header="Küçük" IsCheckable="True"
                          Click="MenuViewDensity_Click"/>
                <MenuItem x:Name="MenuViewMedium" Header="Orta" IsCheckable="True"
                          Click="MenuViewDensity_Click"/>
                <MenuItem x:Name="MenuViewLarge" Header="Büyük" IsCheckable="True"
                          Click="MenuViewDensity_Click"/>
            </MenuItem>
            <MenuItem Header="Sıralama ölçütü" Tag="⇅" ItemContainerStyle="{StaticResource EmptySubmenuLeafStyle}">
                <MenuItem x:Name="MenuSortName" Header="İsim" IsCheckable="True"
                          Click="MenuSortBy_Click"/>
                <MenuItem x:Name="MenuSortSize" Header="Boyut" IsCheckable="True"
                          Click="MenuSortBy_Click"/>
                <MenuItem x:Name="MenuSortType" Header="Tür" IsCheckable="True"
                          Click="MenuSortBy_Click"/>
                <MenuItem x:Name="MenuSortDate" Header="Tarih" IsCheckable="True"
                          Click="MenuSortBy_Click"/>
            </MenuItem>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <MenuItem Header="Tümünü seç" Tag="☑" Click="MenuSelectAll_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Border x:Name="RootChrome" BorderBrush="#2A2A2A" BorderThickness="1,0,1,1" CornerRadius="0" Background="#121212" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Özel Title Bar -->
            <Border x:Name="TitleBarChrome" Grid.Row="0" Background="#181818" CornerRadius="0" ClipToBounds="True"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="14,0,8,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/mdm-logo.png" Width="18" Height="18"
                               Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="MuckDownloadManager" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtVersion" Text="" Foreground="#666666" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="TitleBarChromeButtons" Grid.Column="1"
                            Background="Transparent" VerticalAlignment="Stretch"
                            HorizontalAlignment="Right" Margin="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                            <Button x:Name="BtnMinimize" Content="&#xE921;" Style="{StaticResource TitleBarChromeButtonStyle}"
                                    Click="BtnMinimize_Click" ToolTip="Küçült"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button x:Name="BtnMaximize" Content="&#xE922;" Style="{StaticResource TitleBarChromeButtonStyle}"
                                    Click="BtnMaximize_Click" ToolTip="Büyüt"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource TitleBarCloseButtonStyle}"
                                    Click="BtnClose_Click" ToolTip="Kapat"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Ana İçerik: alt köşeler oval -->
            <Border x:Name="ContentChrome" Grid.Row="1" Background="#121212" CornerRadius="0" ClipToBounds="True">
                <Grid x:Name="MainSplitGrid" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarCol" Width="200" MinWidth="160" MaxWidth="280"/>
                        <ColumnDefinition x:Name="SplitterCol" Width="4"/>
                        <ColumnDefinition Width="*" MinWidth="480"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol kategori paneli -->
                    <Border x:Name="SidebarPanel" Grid.Column="0" Margin="8,8,0,8"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1"
                            CornerRadius="14"
                            AllowDrop="True" Drop="LstCategories_Drop" DragOver="LstCategories_DragOver"
                            ContextMenu="{StaticResource CategoryPanelEmptyContextMenu}">
                        <Grid x:Name="SidebarInner" Margin="8,10,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tum indirilenler — Style Setter kullan (local Foreground hover'ı ezer) -->
                            <Button x:Name="BtnAllDownloads" Grid.Row="0" Click="BtnAllDownloads_Click"
                                    AllowDrop="True" Drop="BtnAllDownloads_Drop" DragOver="BtnAllDownloads_DragOver"
                                    Cursor="Hand" Margin="0,0,0,8" Height="32"
                                    HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent"
                                    ToolTip="Tüm indirilenleri göster" Tag="idle">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,0">
                                                        <TextBlock x:Name="lbl" Text="Tüm indirilenler" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SidebarHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="Tag" Value="selected">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource CategorySelectedBgBrush}"/>
                                                            <Setter Property="Foreground" Value="#FF6B00"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="Tag" Value="selected"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource CategorySelectedBgBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SidebarHoverBrightBrush}"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBlock x:Name="LblCategoriesHeader" Grid.Row="1" Text="Kategoriler"
                                       Foreground="{DynamicResource HeaderTextBrush}" FontSize="11" FontWeight="Bold"
                                       Margin="8,0,0,8"/>

                            <Grid Grid.Row="2" ClipToBounds="True"
                                  PreviewMouseLeftButtonDown="CatMarquee_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="CatMarquee_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="CatMarquee_PreviewMouseLeftButtonUp"
                                  LostMouseCapture="CatMarquee_LostMouseCapture">
                            <ListBox x:Name="LstCategories"
                                     Background="Transparent" BorderThickness="0"
                                     Focusable="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemContainerStyle="{StaticResource CategoryListItemStyle}"
                                     SelectionMode="Extended"
                                     SelectionChanged="LstCategories_SelectionChanged"
                                     PreviewMouseLeftButtonDown="LstCategories_PreviewMouseLeftButtonDown"
                                     PreviewMouseRightButtonDown="LstCategories_PreviewMouseRightButtonDown"
                                     PreviewMouseMove="LstCategories_PreviewMouseMove"
                                     GiveFeedback="LstCategories_GiveFeedback"
                                     QueryContinueDrag="LstCategories_QueryContinueDrag"
                                     Drop="LstCategories_Drop"
                                     DragOver="LstCategories_DragOver"
                                     DragLeave="LstCategories_DragLeave"
                                     AllowDrop="True"
                                     ContextMenu="{x:Null}"
                                     PreviewKeyDown="LstCategories_PreviewKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" BorderBrush="{Binding NestAccentBrush}"
                                                BorderThickness="{Binding NestAccentThickness}" CornerRadius="8" Padding="2,0">
                                            <DockPanel LastChildFill="True" Margin="{Binding IndentMargin}">
                                                <Button DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,4,0"
                                                        Tag="{Binding}" Click="CategoryExpand_Click"
                                                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                        VerticalAlignment="Center" Focusable="False">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent">
                                                                            <TextBlock x:Name="arrow" Text="▸" FontSize="10" Foreground="{DynamicResource HeaderTextBrush}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter TargetName="arrow" Property="Text" Value="▾"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock DockPanel.Dock="Right" Text="⠿" FontSize="10" Opacity="0.45"
                                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                                           ToolTip="Sürükle: üste/alta sıra · ortaya bırak = içine ekle · Tüm indirilenler = dışarı çıkar"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}"
                                                           FontSize="11" Opacity="0.75" Margin="0,0,6,0"
                                                           VerticalAlignment="Center" MinWidth="14"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Surukle ghost -->
                            <Popup x:Name="CategoryDragPopup" AllowsTransparency="True" IsHitTestVisible="False"
                                   Placement="Absolute" StaysOpen="True">
                                <Border Background="#2A2118" BorderBrush="#FF6B00" BorderThickness="1"
                                        CornerRadius="9" Padding="12,8" Opacity="0.92">
                                    <TextBlock x:Name="TxtDragGhost" Foreground="#FF6B00" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </Popup>

                            <Canvas x:Name="CatSelectionCanvas" IsHitTestVisible="False">
                                <Rectangle x:Name="CatSelectionRect" Visibility="Collapsed"
                                           Stroke="{DynamicResource MarqueeStrokeBrush}" StrokeThickness="0"
                                           Fill="{DynamicResource MarqueeFillBrush}"
                                           RadiusX="6" RadiusY="6"/>
                                <Border x:Name="CatDropInsertLine" Visibility="Collapsed"
                                        Background="#FF6B00" Height="2" CornerRadius="1"
                                        Width="160"/>
                                <Border x:Name="CatDropNestHighlight" Visibility="Collapsed"
                                        Background="Transparent" BorderBrush="#FF6B00" BorderThickness="1"
                                        CornerRadius="8"/>
                            </Canvas>
                            </Grid>

                        </Grid>
                    </Border>

                    <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                  Cursor="SizeWE" Margin="0,20,0,20"
                                  DragCompleted="MainSplitter_DragCompleted">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="Transparent">
                                    <Border Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                            Background="#2A2A2A" CornerRadius="1"
                                            Margin="0,8"/>
                                </Grid>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Sağ yüzen içerik paneli -->
                    <Border x:Name="ContentPanel" Grid.Column="2" Margin="2,8,8,8"
                            Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1"
                            CornerRadius="14">
                        <Grid x:Name="ContentInner" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Ust arac cubugu: Yeni Sil Ac Klasorde Ac | Ara | Menu -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                    <ColumnDefinition x:Name="SearchCol" Width="180" MinWidth="90" MaxWidth="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ToolbarFlatButtonStyle}" Click="ToolbarNew_Click"
                                            ToolTip="Yeni indirme">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="LblToolbarNew" Text="Yeni" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarFlatButtonStyle}" Click="ToolbarDelete_Click"
                                            ToolTip="Seçilenleri sil">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="LblToolbarDelete" Text="Sil" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarFlatButtonStyle}" Click="ToolbarOpen_Click"
                                            ToolTip="Dosyayı aç">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="LblToolbarOpen" Text="Aç" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnToolbarFolder" Style="{StaticResource ToolbarFlatButtonStyle}" Click="ToolbarOpenFolder_Click"
                                            ToolTip="Klasörde aç">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="LblToolbarFolder" Text="Klasörü aç" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Border x:Name="SearchBoxBorder" Grid.Column="1" Background="#252525"
                                        CornerRadius="6" Height="30" Margin="4,0,6,0"
                                        HorizontalAlignment="Stretch"
                                        SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SearchBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SearchHoverBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SearchFocusBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock x:Name="TxtSearchPlaceholder" Text="Search" Foreground="#666" Margin="10,0,28,0"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource RowTextBrush}" CaretBrush="#FFFFFF" FontSize="12"
                                                 SelectionBrush="#3D4F66" SelectionTextBrush="#FFFFFF"
                                                 VerticalContentAlignment="Center" Padding="10,0,28,0"
                                                 TextChanged="TxtSearch_TextChanged"
                                                 PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
                                        <TextBlock x:Name="IcoSearchGlyph" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="#777" HorizontalAlignment="Right" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>

                                <Button x:Name="BtnToolbarSettings" Grid.Column="2" Width="32" Height="30"
                                        Style="{StaticResource ToolbarIconOnlyButtonStyle}" Margin="0"
                                        Click="ToolbarSettings_Click" ToolTip="Ayarlar"
                                        MouseEnter="ToolbarSettings_MouseEnter"
                                        MouseLeave="ToolbarSettings_MouseLeave">
                                    <TextBlock x:Name="IcoToolbarSettings" Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="#C8C8C8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <!-- Liste: oval clip -->
                            <Border x:Name="ListPanelBorder" Grid.Row="1" Background="{DynamicResource CardDark}"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    CornerRadius="14" ClipToBounds="True"
                                    SizeChanged="ListPanelBorder_SizeChanged">
                                <Grid x:Name="DownloadListHost" ClipToBounds="True"
                                      Background="Transparent"
                                      PreviewMouseLeftButtonDown="Marquee_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="Marquee_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="Marquee_PreviewMouseLeftButtonUp"
                                      LostMouseCapture="Marquee_LostMouseCapture">

                    <DataGrid x:Name="DgDownloads" AutoGenerateColumns="False" IsReadOnly="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="Transparent" RowBackground="Transparent" 
                              BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None"
                              Foreground="White" CanUserSortColumns="True" AllowDrop="True"
                              CanUserResizeColumns="True" CanUserReorderColumns="True"
                              FrozenColumnCount="0"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ContextMenu="{StaticResource EmptyContextMenu}"
                              MouseDoubleClick="DgDownloads_MouseDoubleClick" Drop="DgDownloads_Drop"
                              PreviewMouseLeftButtonDown="DgDownloads_PreviewMouseLeftButtonDown"
                              PreviewKeyDown="DgDownloads_PreviewKeyDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SizeChanged="DgDownloads_SizeChanged"
                              SelectionChanged="DgDownloads_SelectionChanged">

                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1A1A1A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF6B00"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1A1A1A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF6B00"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF6B00"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF8533"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.GradientActiveCaptionBrushKey}" Color="#FF6B00"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionBrushKey}" Color="#FF6B00"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A2118"/>

                            <!-- Kolon birakma gostergesi — duz turuncu -->
                            <Style TargetType="Separator">
                                <Setter Property="Background" Value="#FF6B00"/>
                                <Setter Property="BorderBrush" Value="#FF6B00"/>
                                <Setter Property="Foreground" Value="#FF6B00"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Background="#FF6B00" Width="2"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Kolon ayirici (resize) — duz turuncu, glow yok -->
                            <Style x:Key="ColumnHeaderGripperStyle" TargetType="{x:Type Thumb}">
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="SizeWE"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="Transparent">
                                                <Rectangle x:Name="gripLine"
                                                           Width="2"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Stretch"
                                                           Margin="0,6"
                                                           Fill="#3A3A3A"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="gripLine" Property="Fill" Value="#FF6B00"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="gripLine" Property="Fill" Value="#FF6B00"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
                                <Setter Property="Padding" Value="10,7"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ContextMenu" Value="{StaticResource ColumnHeaderContextMenu}"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ColumnHeader_PreviewMouseLeftButtonDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Grid Background="{TemplateBinding Background}" Margin="0" SnapsToDevicePixels="True">
                                                <Border x:Name="headerBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderThickness="0" Margin="0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </Border>
                                                <Border Height="1" VerticalAlignment="Bottom"
                                                        Background="{DynamicResource HeaderLineBrush}"
                                                        IsHitTestVisible="False"/>
                                                <Thumb x:Name="PART_LeftHeaderGripper"
                                                       HorizontalAlignment="Left"
                                                       Width="0"
                                                       Visibility="Collapsed"/>
                                                <Thumb x:Name="PART_RightHeaderGripper"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource ColumnHeaderGripperStyle}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Column.CanUserResize, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                                    <Setter TargetName="PART_RightHeaderGripper" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="headerBorder" Property="Background" Value="{DynamicResource HeaderHoverBgBrush}"/>
                                                </Trigger>
                                                <Trigger Property="Tag" Value="active">
                                                    <Setter Property="Foreground" Value="#FF6B00"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Ascending">
                                                    <Setter Property="Foreground" Value="#FF6B00"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Descending">
                                                    <Setter Property="Foreground" Value="#FF6B00"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource RowSelectedBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource RowSelectedFgBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource RowTextBrush}"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                                <EventSetter Event="MouseMove" Handler="DataGridRow_MouseMove"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    CornerRadius="8"
                                                    Margin="2,1"
                                                    SnapsToDevicePixels="True">
                                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource RowHoverBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource RowHoverFgBrush}"/>
                                    </MultiTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource RowSelectedBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource RowSelectedFgBrush}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource RowSelectedHoverBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource RowSelectedHoverFgBrush}"/>
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Secim tik -->
                            <DataGridTemplateColumn x:Name="ColCheck" Width="40" MinWidth="36" MaxWidth="44"
                                                    CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="ChkSelectAll" Width="17" Height="17"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Click="ChkSelectAll_Click"
                                              Style="{StaticResource DarkCheckBoxStyle}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="17" Height="17"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown"
                                                  Style="{StaticResource DarkCheckBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn x:Name="ColFileName" Header="Dosya Adı" Width="2*" MinWidth="64"
                                                    IsReadOnly="True" SortMemberPath="FileName" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding FileIcon}"
                                                   Width="{DynamicResource ListIconSize}"
                                                   Height="{DynamicResource ListIconSize}"
                                                   MinWidth="{DynamicResource ListIconSize}"
                                                   MinHeight="{DynamicResource ListIconSize}"
                                                   MaxWidth="{DynamicResource ListIconSize}"
                                                   MaxHeight="{DynamicResource ListIconSize}"
                                                   Margin="0,0,8,0" Stretch="Uniform" StretchDirection="Both"
                                                   Opacity="0.95" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   SnapsToDevicePixels="True"/>
                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       FontSize="{DynamicResource ListNameFontSize}"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="ColSize" Header="Boyut" Binding="{Binding FileSize}"
                                                SortMemberPath="FileSizeBytes" Width="*" MinWidth="52" MaxWidth="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="ColType" Header="Tür" Binding="{Binding FileType}" Width="Auto" MinWidth="36" MaxWidth="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="ColDate" Header="Tarih" Binding="{Binding DateAdded, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="Auto" MinWidth="80" MaxWidth="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn x:Name="ColStatus" Header="Durum" Width="*" MinWidth="120" MaxWidth="240"
                                                    IsReadOnly="True" SortMemberPath="Status" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="0,2">
                                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <DockPanel LastChildFill="True">
                                                <DockPanel.Style>
                                                    <Style TargetType="DockPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DockPanel.Style>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentSpeed}"
                                                           FontSize="10" Foreground="#FF6B00" FontWeight="SemiBold"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="İndiriliyor" FontSize="10"
                                                                   Foreground="{DynamicResource DownloadingStatusBrush}"/>
                                                        <TextBlock Text="{Binding ProgressValue, StringFormat= %{0:F1}}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource DownloadingStatusBrush}"
                                                                   Margin="4,0,8,0"/>
                                                    </StackPanel>
                                                    <ProgressBar Minimum="0" Maximum="100"
                                                                 Value="{Binding ProgressValue}"
                                                                 Height="5" Margin="0,4,0,0"
                                                                 HorizontalAlignment="Stretch"
                                                                 Foreground="#FF6B00"
                                                                 Background="{DynamicResource DownloadingTrackBrush}"
                                                                 Style="{StaticResource OrangeProgressBarStyle}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Satir aksiyonlari: tamamlaninca gizlenir -->
                            <DataGridTemplateColumn x:Name="ColActions" Header="" SortMemberPath="__actions"
                                                    Width="100" MinWidth="100" MaxWidth="100"
                                                    CanUserResize="False" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="2,1"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Background}"/>
                                        <Setter Property="ClipToBounds" Value="False"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}" BorderThickness="0"
                                                            Padding="{TemplateBinding Padding}" ClipToBounds="False">
                                                        <ContentPresenter VerticalAlignment="Center"
                                                                          HorizontalAlignment="Right"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                CornerRadius="6" Padding="1,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowRowActions}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                            <Button ToolTip="{Binding PauseResumeTip}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    Click="RowPauseResume_Click"
                                                    IsEnabled="{Binding CanPauseResume}"
                                                    Tag="{Binding}">
                                                <Grid Width="9" Height="9">
                                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Stretch="Uniform"
                                                          Data="M3,2.5 H6.2 V13.5 H3 Z M9.8,2.5 H13 V13.5 H9.8 Z">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPausedState}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsErrorState}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Stretch="Uniform"
                                                          Data="M4,2.2 L13.5,8 L4,13.8 Z">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPausedState}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsErrorState}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </Button>
                                            <Rectangle Width="1" Height="10" Fill="{DynamicResource RowActionSepBrush}" Margin="0" VerticalAlignment="Center"/>
                                            <Button ToolTip="İndirme penceresi" Style="{StaticResource RowActionButtonStyle}"
                                                    Click="RowOpenDownload_Click" Tag="{Binding}">
                                                <Path Width="9" Height="9" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Fill="Transparent"
                                                      Data="M2.5,4.2 H13.5 V12.8 H2.5 Z M2.5,4.2 H13.5 V6.6 H2.5 Z M7.2,9.2 H11.2"/>
                                            </Button>
                                            <Rectangle Width="1" Height="10" Fill="{DynamicResource RowActionSepBrush}" Margin="0" VerticalAlignment="Center"/>
                                            <Button ToolTip="İptal et" Style="{StaticResource RowActionDangerButtonStyle}"
                                                    Click="RowCancel_Click" Tag="{Binding}">
                                                <Path Width="9" Height="9" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M2,2 L12,12 M12,2 L2,12"/>
                                            </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRect"
                                   Visibility="Collapsed"
                                   Stroke="{DynamicResource MarqueeStrokeBrush}"
                                   StrokeThickness="0"
                                   Fill="{DynamicResource MarqueeFillBrush}"
                                   RadiusX="6"
                                   RadiusY="6"/>
                    </Canvas>

                    <!-- Dosya sürükle — çoklu seçimde yığılmış ikon + adet rozeti -->
                    <Popup x:Name="FileDragPopup" AllowsTransparency="True" IsHitTestVisible="False"
                           Placement="Absolute" StaysOpen="True">
                        <Border x:Name="FileDragGhostCard" Background="#CC1A1A1A" BorderBrush="#55FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="10,8" Opacity="0.97" MaxWidth="300">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="46" Height="38" Margin="0,0,10,0">
                                    <Image x:Name="ImgFileDragGhost3" Width="20" Height="20"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Margin="14,0,0,2" Stretch="Uniform" Opacity="0.55"/>
                                    <Image x:Name="ImgFileDragGhost2" Width="24" Height="24"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Margin="7,0,0,5" Stretch="Uniform" Opacity="0.78"/>
                                    <Image x:Name="ImgFileDragGhost" Width="28" Height="28"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Stretch="Uniform"/>
                                    <Border x:Name="FileDragCountBadge" Background="#CC2E2E2E" BorderBrush="#55FFFFFF"
                                            BorderThickness="1" CornerRadius="9"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-5,-6,0" Padding="6,2" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtFileDragCount" Foreground="#F0F0F0"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFileDragGhost" Foreground="#F0F0F0" FontSize="12"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    <TextBlock x:Name="TxtFileDragSub" Foreground="#999999" FontSize="10"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Baglanti kopyalandi — modern hafif toast -->
                    <Border x:Name="CopyToast" Grid.Column="0" Grid.ColumnSpan="3"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,22,26" Padding="12,8" CornerRadius="20"
                            Background="#CC1A1A1A" BorderBrush="#33FF6B00" BorderThickness="1"
                            Visibility="Collapsed" IsHitTestVisible="False" Opacity="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#FF6B00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Bağlantı kopyalandı" Foreground="#E8E8E8"
                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Uygulama içi karartmalı modal popup (ayarlar/kurallar üstünde) -->
            <Border x:Name="ModalOverlay" Grid.Row="0" Grid.RowSpan="2"
                    Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="1200"
                    IsHitTestVisible="True" PreviewKeyDown="ModalOverlay_PreviewKeyDown"
                    MouseLeftButtonDown="ModalOverlay_BackdropClick"
                    UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <Border x:Name="ModalCard" Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1"
                            CornerRadius="12" MinWidth="360" MaxWidth="460"
                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Display"
                            TextOptions.TextRenderingMode="ClearType">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="ModalTitleBar" Background="#242424" CornerRadius="12,12,0,0">
                                <Grid>
                                    <TextBlock x:Name="ModalTitle" Text="" Margin="16,0,44,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"
                                               Foreground="#F2F2F2"
                                               TextOptions.TextFormattingMode="Display"/>
                                    <Button x:Name="ModalCloseBtn" HorizontalAlignment="Right" Width="40" Height="38"
                                            Content="✕" Click="ModalClose_Click" Cursor="Hand"
                                            Foreground="#BBB" BorderThickness="0" Background="Transparent" FontSize="12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,11,0,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="18,16,18,8">
                                <TextBlock x:Name="ModalMessage" Text="" TextWrapping="Wrap"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"
                                           TextOptions.TextFormattingMode="Display"/>
                                <TextBlock x:Name="ModalDetail" Text="" TextWrapping="Wrap"
                                           FontSize="12" Foreground="#B0B0B0" LineHeight="18"
                                           TextOptions.TextFormattingMode="Display"/>
                            </StackPanel>
                            <StackPanel x:Name="ModalButtons" Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="18,8,18,16">
                                <Button x:Name="ModalCancelBtn" Content="İptal" MinWidth="84" Height="32" Margin="0,0,8,0"
                                        Click="ModalCancel_Click" Cursor="Hand" Foreground="#EEE" BorderThickness="0" FontSize="12">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#2F2F2F" CornerRadius="8" Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="ModalConfirmBtn" Content="Onayla" MinWidth="84" Height="32"
                                        Click="ModalConfirm_Click" Cursor="Hand" Foreground="White" BorderThickness="0"
                                        FontSize="12" FontWeight="SemiBold" FocusVisualStyle="{x:Null}"
                                        IsTabStop="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Ayarlar — uygulamaya sabit, arka plan karartmalı popup -->
            <Border x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2"
                    Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="1100"
                    IsHitTestVisible="True" PreviewKeyDown="SettingsOverlay_PreviewKeyDown"
                    MouseLeftButtonDown="SettingsOverlay_BackdropClick">
                <local:SettingsDialog x:Name="SettingsPanel"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      MouseLeftButtonDown="OverlayCard_MouseLeftButtonDown"/>
            </Border>

            <!-- Dosya türleri — uygulamaya sabit, arka plan karartmalı popup -->
            <Border x:Name="RulesOverlay" Grid.Row="0" Grid.RowSpan="2"
                    Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="1100"
                    IsHitTestVisible="True" PreviewKeyDown="RulesOverlay_PreviewKeyDown"
                    MouseLeftButtonDown="RulesOverlay_BackdropClick">
                <local:CategoryRulesDialog x:Name="RulesPanel"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           MouseLeftButtonDown="OverlayCard_MouseLeftButtonDown"/>
            </Border>

            <!-- Yeni indirme — uygulama içi overlay -->
            <Border x:Name="NewUrlOverlay" Grid.Row="0" Grid.RowSpan="2"
                    Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="1150"
                    IsHitTestVisible="True" PreviewKeyDown="NewUrlOverlay_PreviewKeyDown"
                    MouseLeftButtonDown="NewUrlOverlay_BackdropClick">
                <local:NewUrlDialog x:Name="NewUrlPanel"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MouseLeftButtonDown="OverlayCard_MouseLeftButtonDown"/>
            </Border>

            <!-- Metin girişi — uygulama içi overlay -->
            <Border x:Name="PromptOverlay" Grid.Row="0" Grid.RowSpan="2"
                    Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="1150"
                    IsHitTestVisible="True" PreviewKeyDown="PromptOverlay_PreviewKeyDown"
                    MouseLeftButtonDown="PromptOverlay_BackdropClick">
                <local:PromptDialog x:Name="PromptPanel"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MouseLeftButtonDown="OverlayCard_MouseLeftButtonDown"/>
            </Border>

            <!-- Kategori düzenle — uygulama içi overlay -->
            <Border x:Name="CategoryEditOverlay" Grid.Row="0" Grid.RowSpan="2"
                    Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="1150"
                    IsHitTestVisible="True" PreviewKeyDown="CategoryEditOverlay_PreviewKeyDown"
                    MouseLeftButtonDown="CategoryEditOverlay_BackdropClick">
                <local:CategoryEditDialog x:Name="CategoryEditPanel"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          MouseLeftButtonDown="OverlayCard_MouseLeftButtonDown"/>
            </Border>
        </Grid>
    </Border>
</Window>