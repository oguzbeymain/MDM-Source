<Window x:Class="DownloadMuck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MuckDownloadManager" Height="600" Width="980"
        MinHeight="420" MinWidth="720"
        Background="Transparent" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="CanResize"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#121212"/>
        <SolidColorBrush x:Key="SidebarDark" Color="#181818"/>
        <SolidColorBrush x:Key="CardDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="InputDark" Color="#262626"/>
        <SolidColorBrush x:Key="OrangeAccent" Color="#FF6B00"/>
        <SolidColorBrush x:Key="OrangeHover" Color="#FF8533"/>

        <!-- Genel Progress Bar Stili -->
        <Style x:Key="OrangeProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource OrangeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Rectangle x:Name="PART_Track"/>
                            <Grid x:Name="PART_Indicator" ClipToBounds="true" HorizontalAlignment="Left">
                                <Rectangle x:Name="Indicator" Fill="{TemplateBinding Foreground}" RadiusX="4" RadiusY="4"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Turuncu Buton Stili -->
        <Style x:Key="OrangeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OrangeAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource OrangeHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Koyu Buton Stili -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- İptal Buton Stili -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A1C1C"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#552222"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#552222"/>
                                <Setter Property="Foreground" Value="#FF8888"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title bar: kucult / buyut -->
        <Style x:Key="TitleBarChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#00000000" ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#28FFFFFF" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                                        To="#F5F5F5" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#00000000" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                                        To="#888888" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title bar: kapat — sag ust oval, tasmasiz -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#00000000" CornerRadius="0,15,0,0" ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#E53935" Duration="0:0:0.16"/>
                                        <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                                        To="#FFFFFF" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#00000000" Duration="0:0:0.16"/>
                                        <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                                        To="#888888" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sol menü kategori butonu — yumusak hover (overlay) -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="hoverGlow" Background="#FF6B00" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.14" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Box Stili -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Satir sag tik -->
        <ContextMenu x:Key="RowContextMenu"
                     Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1"
                            CornerRadius="10" Padding="6" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#E8E8E8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="12,9"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}"
                                                   Width="22" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="#2A2118"/>
                                        <Setter Property="Foreground" Value="#FF6B00"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ModernSeparator" TargetType="Separator">
                    <Setter Property="Margin" Value="8,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Background="#333333" Margin="{TemplateBinding Margin}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="Dosya konumunu aç" Tag="📂" Click="MenuOpenFolder_Click"/>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <MenuItem Header="Listeden ve diskten sil" Tag="🗑" Click="MenuDeleteFile_Click"/>
        </ContextMenu>

        <!-- Bos alan sag tik -->
        <ContextMenu x:Key="EmptyContextMenu"
                     Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1"
                            CornerRadius="10" Padding="6" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#E8E8E8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="12,9"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}"
                                                   Width="22" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="#2A2118"/>
                                        <Setter Property="Foreground" Value="#FF6B00"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="Yenile" Tag="🔄" Click="MenuRefresh_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Border x:Name="RootChrome" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="16" Background="#121212" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Özel Title Bar -->
            <Border Grid.Row="0" Background="#181818" CornerRadius="16,16,0,0" ClipToBounds="True" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="8" Height="16" Background="{StaticResource OrangeAccent}" CornerRadius="4" Margin="0,0,8,0"/>
                        <TextBlock Text="MuckDownloadManager" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtVersion" Text="" Foreground="#666666" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="—" Style="{StaticResource TitleBarChromeButtonStyle}" FontSize="14" Click="BtnMinimize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnMaximize" Content="☐" Style="{StaticResource TitleBarChromeButtonStyle}" Click="BtnMaximize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ana İçerik: alt köşeler oval -->
            <Border Grid.Row="1" Background="#101010" CornerRadius="0,0,16,16" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: kategori + ayrı ayarlar -->
                    <Grid Grid.Column="0" Width="196" Margin="14,12,6,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" VerticalAlignment="Stretch"
                                Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1"
                                CornerRadius="16" MinHeight="280">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel Margin="12,16,12,16" VerticalAlignment="Top">
                                <Button x:Name="BtnCatAll" Content="⚡  Tüm İndirilenler" Style="{StaticResource CategoryButtonStyle}"
                                        Tag="All" Click="Category_Click" Margin="0,0,0,14"/>

                                <TextBlock Text="Kategoriler" Foreground="#777777" FontSize="11" FontWeight="Bold" Margin="8,0,0,10"/>

                                <Button x:Name="BtnCatDocuments" Content="📁  Dökümanlar" Tag="Documents" Style="{StaticResource CategoryButtonStyle}" Click="Category_Click"/>
                                <Button x:Name="BtnCatVideos" Content="🎬  Videolar" Tag="Videos" Style="{StaticResource CategoryButtonStyle}" Click="Category_Click"/>
                                <Button x:Name="BtnCatAudio" Content="🎵  Sesler" Tag="Audio" Style="{StaticResource CategoryButtonStyle}" Click="Category_Click"/>
                                <Button x:Name="BtnCatArchives" Content="📦  Arşivler" Tag="Archives" Style="{StaticResource CategoryButtonStyle}" Click="Category_Click"/>
                                <Button x:Name="BtnCatApps" Content="🚀  Uygulamalar" Tag="Apps" Style="{StaticResource CategoryButtonStyle}" Click="Category_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Ayrı yüzen ayarlar -->
                        <Border Grid.Row="1" Margin="0,8,0,0" Height="48"
                                Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1"
                                CornerRadius="14" Cursor="Hand" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <Button x:Name="BtnSettings" Click="BtnSettings_Click" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                    Padding="14,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                                            <Grid>
                                                <Border x:Name="hoverGlow" Background="#FF6B00" CornerRadius="14" Opacity="0" IsHitTestVisible="False"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="iconTxt" Text="⚙" FontSize="16" Foreground="#FF6B00" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="labelTxt" Text="Ayarlar" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="hoverGlow"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.14" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetName="labelTxt"
                                                                        Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                        To="#FF6B00" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="hoverGlow"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.22"/>
                                                        <ColorAnimation Storyboard.TargetName="labelTxt"
                                                                        Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                        To="#CCCCCC" Duration="0:0:0.22"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                    </Grid>

                    <!-- Sağ yüzen içerik paneli -->
                    <Border Grid.Column="1" Margin="6,12,14,14"
                            Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1"
                            CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                        </Border.Effect>
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kayıt Adresi:" Foreground="#888888" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtDefaultFolder" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34"/>
                                <Button x:Name="BtnBrowseFolder" Content="Gözat" Grid.Column="2" Style="{StaticResource DarkButtonStyle}" Height="34" Margin="5,0,0,0" Click="BtnBrowseFolder_Click"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtUrl" Style="{StaticResource ModernTextBoxStyle}" Height="34" Text=""/>
                                <Button x:Name="BtnDownload" Content="İndir" Grid.Column="1" Style="{StaticResource OrangeButtonStyle}" Height="34" Margin="5,0,0,0" Click="BtnDownload_Click"/>
                                <Button x:Name="BtnPauseResume" Content="Duraklat" Grid.Column="2" Style="{StaticResource DarkButtonStyle}" Height="34" Margin="5,0,0,0" IsEnabled="False" Click="BtnPauseResume_Click"/>
                                <Button x:Name="BtnCancel" Content="İptal" Grid.Column="3" Style="{StaticResource CancelButtonStyle}" Height="34" Margin="5,0,0,0" IsEnabled="False" Click="BtnCancel_Click"/>
                            </Grid>

                            <!-- Liste: oval clip -->
                            <Border x:Name="ListPanelBorder" Grid.Row="2" Background="{StaticResource CardDark}"
                                    BorderBrush="#262626" BorderThickness="1"
                                    CornerRadius="14" ClipToBounds="True"
                                    SizeChanged="ListPanelBorder_SizeChanged">
                                <Grid x:Name="DownloadListHost" ClipToBounds="True"
                                      Background="Transparent"
                                      PreviewMouseLeftButtonDown="Marquee_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="Marquee_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="Marquee_PreviewMouseLeftButtonUp"
                                      LostMouseCapture="Marquee_LostMouseCapture">

                    <DataGrid x:Name="DgDownloads" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="Transparent" RowBackground="Transparent" 
                              BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None"
                              Foreground="White" CanUserSortColumns="True" AllowDrop="True"
                              CanUserResizeColumns="True" CanUserReorderColumns="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ContextMenu="{StaticResource EmptyContextMenu}"
                              MouseDoubleClick="DgDownloads_MouseDoubleClick" Drop="DgDownloads_Drop"
                              PreviewKeyDown="DgDownloads_PreviewKeyDown"
                              SelectionChanged="DgDownloads_SelectionChanged">

                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#251A12"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF6B00"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#251A12"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF6B00"/>

                            <!-- Kolon ayirici (resize) tutamaci -->
                            <Style x:Key="ColumnHeaderGripperStyle" TargetType="{x:Type Thumb}">
                                <Setter Property="Width" Value="10"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="SizeWE"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="gripBg" Background="Transparent">
                                                <Rectangle x:Name="gripLine"
                                                           Width="2"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Stretch"
                                                           Margin="0,4"
                                                           RadiusX="1" RadiusY="1"
                                                           Fill="#3A3A3A"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="gripBg" Property="Background" Value="#40FF6B00"/>
                                                    <Setter TargetName="gripLine" Property="Fill" Value="#FF6B00"/>
                                                    <Setter TargetName="gripLine" Property="Width" Value="3"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="gripBg" Property="Background" Value="#66FF6B00"/>
                                                    <Setter TargetName="gripLine" Property="Fill" Value="#FF8533"/>
                                                    <Setter TargetName="gripLine" Property="Width" Value="3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="Padding" Value="10,10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Grid Background="Transparent">
                                                <Border x:Name="headerBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="#222222"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="0">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </Border>
                                                <Thumb x:Name="PART_LeftHeaderGripper"
                                                       HorizontalAlignment="Left"
                                                       Width="0"
                                                       Visibility="Collapsed"/>
                                                <Thumb x:Name="PART_RightHeaderGripper"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource ColumnHeaderGripperStyle}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                                    <Setter TargetName="headerBorder" Property="CornerRadius" Value="13,0,0,0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Column.CanUserResize, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                                    <Setter TargetName="PART_RightHeaderGripper" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="headerBorder" Property="CornerRadius" Value="0,13,0,0"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="headerBorder" Property="Background" Value="#222222"/>
                                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Ascending">
                                                    <Setter Property="Foreground" Value="#FF6B00"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Descending">
                                                    <Setter Property="Foreground" Value="#FF6B00"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown"/>
                                <EventSetter Event="MouseMove" Handler="DataGridRow_MouseMove"/>

                                <Style.Triggers>
                                    <!-- Sadece hover: hafif arka plan, yazi gri kalsin -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="#222222"/>
                                        <Setter Property="Foreground" Value="#F5F5F5"/>
                                    </MultiTrigger>
                                    <!-- Secili -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#251A12"/>
                                        <Setter Property="Foreground" Value="#FF6B00"/>
                                    </Trigger>
                                    <!-- Secili + hover -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="#332318"/>
                                        <Setter Property="Foreground" Value="#FF8533"/>
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Dosya Adı" Width="*" MinWidth="140" MaxWidth="900">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding FileIcon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Boyut" Binding="{Binding FileSize}" Width="100" MinWidth="72" MaxWidth="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tür" Binding="{Binding FileType}" Width="80" MinWidth="56" MaxWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding DateAdded, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130" MinWidth="110" MaxWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Durum Sütunu Güncellemesi -->
                            <DataGridTemplateColumn Header="Durum" Width="180" MinWidth="140" MaxWidth="320" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <!-- Tamamlandı veya Normal Durum -->
                                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- İndiriliyor Detayı (Titreşimi önlemek için sabit renkler eklendi) -->
                                            <StackPanel Orientation="Vertical">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#CCCCCC" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding CurrentSpeed}" FontSize="10" Foreground="{StaticResource OrangeAccent}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="5" 
                                 Style="{StaticResource OrangeProgressBarStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                        </DataGrid.Columns>
                    </DataGrid>

                    <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRect"
                                   Visibility="Collapsed"
                                   Stroke="#FF6B00"
                                   StrokeThickness="1"
                                   Fill="#33FF6B00"
                                   RadiusX="4"
                                   RadiusY="4"/>
                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>