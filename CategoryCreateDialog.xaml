<Window x:Class="MDM.CategoryCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni kategori" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=TxtName}">
    <Border x:Name="DlgChrome" Background="#1B1B1B" BorderBrush="#333" BorderThickness="1" CornerRadius="12" Margin="0">
        <Grid Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtTitle" Text="Yeni kategori" FontWeight="SemiBold" FontSize="14" Foreground="#EEE" Margin="0,0,0,12"/>

            <TextBlock x:Name="LblName" Grid.Row="1" Text="Kategori adı" Foreground="#999" FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtName" Grid.Row="2" Height="34" FontSize="13"
                     Background="#252525" Foreground="White" BorderBrush="#333" BorderThickness="1"
                     VerticalContentAlignment="Center" Padding="8,0" KeyDown="Txt_KeyDown">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>

            <DockPanel Grid.Row="3" Margin="0,12,0,6">
                <Button x:Name="BtnResetIcon" DockPanel.Dock="Right" Content="Varsayılana dön"
                        Click="BtnResetIcon_Click" Cursor="Hand" FontSize="11" Padding="8,4"
                        VerticalAlignment="Center" Foreground="#999" Background="Transparent" BorderThickness="0"/>
                <TextBlock x:Name="LblIcon" Text="Simge" Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <Border x:Name="IconListBorder" Grid.Row="4" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                    CornerRadius="10" Padding="8" MaxHeight="120" Margin="0,0,0,4">
                <Border.Resources>
                    <Style x:Key="DlgScrollThumb" TargetType="Thumb">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="t" Background="#3A3A3A" CornerRadius="4" Margin="1"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="t" Property="Background" Value="#FF6B00"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="MinWidth" Value="8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent" Margin="1,2">
                                        <Border Background="#1A1A1A" CornerRadius="4" Opacity="0.5"/>
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource DlgScrollThumb}"/>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="IconPanel"/>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="LblFolder" Grid.Row="5" Text="Kayıt klasörü" Foreground="#999" FontSize="12" Margin="0,8,0,6"/>
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFolder" Height="34" FontSize="12"
                         Background="#252525" Foreground="White" BorderBrush="#333" BorderThickness="1"
                         VerticalContentAlignment="Center" IsReadOnly="True">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8,0,0,8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Gözat" Width="72" Height="34" Click="BtnBrowse_Click"
                        Cursor="Hand" Foreground="#EEE" BorderThickness="0" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2D2D2D" CornerRadius="0,8,8,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnCancel" Content="İptal" MinWidth="84" Height="32" Margin="0,0,8,0" Padding="14,0"
                        Click="BtnCancel_Click" Cursor="Hand" Foreground="#CCC" BorderThickness="0" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2D2D2D" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnOk" Content="Oluştur" MinWidth="84" Height="32" Padding="14,0" Click="BtnOk_Click"
                        Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#FF6B00" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
