<UserControl x:Class="DownloadMuck.CategoryRulesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="ExtChipCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="chip" Background="#171717" BorderBrush="#2A2A2A" BorderThickness="1"
                                CornerRadius="8" Padding="8,6" MinWidth="72">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="box" Width="15" Height="15" CornerRadius="2"
                                        Background="#0C0C0C" BorderBrush="#3A3A3A" BorderThickness="1.5"
                                        VerticalAlignment="Center" SnapsToDevicePixels="True">
                                    <Path x:Name="mark" Data="M2.5,7.5 L5.5,10.5 L12,3.5"
                                          Stroke="#FF6B00" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Visibility="Collapsed" Margin="0,0,0,0.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="Background" Value="#1A120C"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF6B00"/>
                                <Setter TargetName="chip" Property="Background" Value="#1E1812"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="#3A2A18"/>
                                <Setter Property="Foreground" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="#444"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#666"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="chip" Property="BorderBrush" Value="#5A3A18"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF8533"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#1B1B1B" BorderBrush="#333" BorderThickness="1" CornerRadius="14"
            Width="440" Height="460" MaxWidth="520" MaxHeight="560">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#1F1F1F" CornerRadius="14,14,0,0">
                <Grid>
                    <TextBlock x:Name="TxtTitle" Text="Dosya türleri" Margin="16,0,0,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0"/>
                    <Button HorizontalAlignment="Right" Width="40" Height="38" Content="✕" Click="BtnCancel_Click"
                            Foreground="#AAA" BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,13,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Bu kategoriye düşecek uzantıları seçin" Foreground="#888" FontSize="11"
                           Margin="0,0,0,10" TextWrapping="Wrap"/>

                <Border Grid.Row="1" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl x:Name="LstExt">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                              Style="{StaticResource ExtChipCheckBox}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtCustom" Height="32" FontSize="12" VerticalContentAlignment="Center"
                             Background="#252525" Foreground="#E0E0E0" BorderBrush="#333" BorderThickness="1"
                             Padding="10,0" ToolTip="Örn: pdf veya .pdf"/>
                    <Button Grid.Column="1" Content="Ekle" Width="68" Height="32" Margin="8,0,0,0"
                            Click="BtnAddCustom_Click" Cursor="Hand" Foreground="#E0E0E0" BorderThickness="0" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#2A2A2A" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#262626" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14" Padding="16,12">
                <Grid>
                    <Button x:Name="BtnResetDefaults" Content="Varsayılana dön" MinWidth="110" Height="32"
                            HorizontalAlignment="Left" Click="BtnResetDefaults_Click" Cursor="Hand"
                            Foreground="#CCC" BorderThickness="0" FontSize="11" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#252525" CornerRadius="8" Padding="12,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#333"/>
                                        <Setter Property="Foreground" Value="#FF6B00"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="İptal" Width="84" Height="32" Margin="0,0,8,0" Click="BtnCancel_Click"
                                Cursor="Hand" Foreground="#CCC" BorderThickness="0" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#252525" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Kaydet" Width="84" Height="32" Click="BtnSave_Click"
                                Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#FF6B00" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
