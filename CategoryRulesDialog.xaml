<UserControl x:Class="MDM.CategoryRulesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ChipBg" Color="#171717"/>
        <SolidColorBrush x:Key="ChipBorder" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ChipBoxBg" Color="#0C0C0C"/>
        <SolidColorBrush x:Key="ChipFg" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="ChipCheckedBg" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="ChipCheckedBorder" Color="#5C5C5C"/>
        <SolidColorBrush x:Key="ChipHoverBorder" Color="#6A6A6A"/>
        <SolidColorBrush x:Key="ChipCheckedBoxBg" Color="#121212"/>
        <SolidColorBrush x:Key="ChipCheckedFg" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="ChipCheckMark" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SoftBtnBg" Color="#252525"/>
        <SolidColorBrush x:Key="SoftBtnFg" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="GroupLabelFg" Color="#888888"/>

        <Style x:Key="ExtGroupSelectCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="17" Height="17" CornerRadius="4.5"
                                Background="{DynamicResource ChipBoxBg}"
                                BorderBrush="{DynamicResource ChipBorder}"
                                BorderThickness="1.2"
                                SnapsToDevicePixels="True">
                            <Viewbox Width="11" Height="11" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <Path x:Name="mark" Data="M3.5,8.5 L6.8,11.8 L13.2,5.2"
                                          Stroke="{DynamicResource ChipCheckMark}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Visibility="Collapsed"/>
                                    <Path x:Name="dash" Data="M4,9 L12,9"
                                          Stroke="{DynamicResource ChipCheckMark}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" Visibility="Collapsed"/>
                                </Grid>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ChipCheckedBoxBg}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ChipCheckedBorder}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ChipCheckedBoxBg}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ChipCheckedBorder}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ChipHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExtChipCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource ChipFg}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="chip" Background="{DynamicResource ChipBg}"
                                BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="8,6" MinWidth="72">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="box" Width="17" Height="17" CornerRadius="4.5"
                                        Background="{DynamicResource ChipBoxBg}"
                                        BorderBrush="{DynamicResource ChipBorder}"
                                        BorderThickness="1.2"
                                        VerticalAlignment="Center" SnapsToDevicePixels="True"
                                        HorizontalAlignment="Center">
                                    <Viewbox Width="11" Height="11" Stretch="Uniform"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="mark" Data="M3.5,8.5 L6.8,11.8 L13.2,5.2"
                                              Stroke="{DynamicResource ChipCheckMark}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Visibility="Collapsed"/>
                                    </Viewbox>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ChipCheckedBoxBg}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ChipCheckedBorder}"/>
                                <Setter TargetName="box" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="chip" Property="Background" Value="{DynamicResource ChipCheckedBg}"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource ChipCheckedBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ChipCheckedFg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource ChipHoverBorder}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ChipHoverBorder}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ChipCheckedBoxBg}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ChipHoverBorder}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RulesSoftButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SoftBtnFg}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource SoftBtnBg}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RulesRoot" Background="#1B1B1B" BorderBrush="#333" BorderThickness="1" CornerRadius="14"
            Width="440" Height="500" MaxWidth="520" MaxHeight="600">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="RulesHeader" Background="#1F1F1F" CornerRadius="14,14,0,0">
                <Grid>
                    <TextBlock x:Name="TxtTitle" Text="Dosya türleri" Margin="16,0,0,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0"/>
                    <Button HorizontalAlignment="Right" Width="40" Height="38" Content="✕" Click="BtnCancel_Click"
                            Foreground="#AAA" BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,13,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtHint" Text="Bu kategoriye düşecek uzantıları seçin" Foreground="#888" FontSize="11"
                           Margin="0,0,0,10" TextWrapping="Wrap"/>

                <Border x:Name="RulesListPanel" Grid.Row="1" Background="#141414" BorderBrush="#2A2A2A"
                        BorderThickness="1" CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                        <ItemsControl x:Name="LstGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                            <CheckBox DockPanel.Dock="Left"
                                                      IsThreeState="True"
                                                      IsChecked="{Binding AllChecked, Mode=TwoWay}"
                                                      Style="{StaticResource ExtGroupSelectCheckBox}"
                                                      ToolTip="{Binding Title}"/>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource GroupLabelFg}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                              Style="{StaticResource ExtChipCheckBox}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtCustom" Height="32" FontSize="12" VerticalContentAlignment="Center"
                             Background="#252525" Foreground="#E0E0E0" BorderBrush="#333" BorderThickness="1"
                             Padding="10,0" ToolTip="Örn: pdf veya .pdf"/>
                    <Button x:Name="BtnAddCustom" Grid.Column="1" Content="Ekle" Width="68" Height="32" Margin="8,0,0,0"
                            Click="BtnAddCustom_Click" Style="{StaticResource RulesSoftButton}"/>
                </Grid>
            </Grid>

            <Border x:Name="RulesFooter" Grid.Row="2" Background="#1A1A1A" BorderBrush="#262626" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14" Padding="16,12">
                <Grid>
                    <Button x:Name="BtnResetDefaults" Content="Varsayılana dön" MinWidth="110" Height="32"
                            HorizontalAlignment="Left" Click="BtnResetDefaults_Click"
                            Style="{StaticResource RulesSoftButton}" FontSize="11" Padding="12,0"
                            Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="İptal" Width="84" Height="32" Margin="0,0,8,0"
                                Click="BtnCancel_Click" Style="{StaticResource RulesSoftButton}"/>
                        <Button x:Name="BtnSave" Content="Kaydet" Width="84" Height="32" Click="BtnSave_Click"
                                Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#FF6B00" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
