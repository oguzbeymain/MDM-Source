<Window x:Class="DownloadMuck.DownloadSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İndirme" Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI" ShowInTaskbar="True"
        Topmost="True">

    <Border Background="#1B1B1B" BorderBrush="#333333" BorderThickness="1" CornerRadius="14" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Background="#222222" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="14" Background="#FF6B00" CornerRadius="2" Margin="0,0,8,0"/>
                        <TextBlock Text="İndirme" FontWeight="SemiBold" FontSize="13" Foreground="#F0F0F0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="28" Height="28" Content="✕"
                            Background="Transparent" Foreground="#888" BorderThickness="0"
                            Cursor="Hand" Click="BtnClose_Click" FontSize="12"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,18,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Image x:Name="ImgIcon" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock x:Name="TxtFileName" Text="dosya" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#EEEEEE" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtFileType" Text="" FontSize="11" Foreground="#888888" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Adres" FontSize="11" Foreground="#777" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUrl" IsReadOnly="True" TextWrapping="NoWrap"
                             Background="#252525" Foreground="#BBBBBB" BorderBrush="#333" BorderThickness="1"
                             Padding="8,6" Margin="0,0,0,12"/>

                    <TextBlock Text="Kayıt klasörü" FontSize="11" Foreground="#777" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFolder" Background="#252525" Foreground="White"
                                 BorderBrush="#333" BorderThickness="1" Padding="8,6"/>
                        <Button Grid.Column="1" Content="Gözat" Margin="8,0,0,0" Padding="12,0" Height="30"
                                Cursor="Hand" Click="BtnBrowse_Click" Background="#2D2D2D" Foreground="#EEE" BorderThickness="0"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Boyut" FontSize="11" Foreground="#777"/>
                            <TextBlock x:Name="TxtSize" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#DDD" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Hız" FontSize="11" Foreground="#777"/>
                            <TextBlock x:Name="TxtSpeed" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#DDD" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TxtStatus" Text="Hazır — başlatmak için Başlat'a bas" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="BarProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Background="#2A2A2A" Foreground="#FF6B00" BorderThickness="0"/>
                    <TextBlock x:Name="TxtPercent" Text="%0" FontSize="11" Foreground="#888" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Margin="18,4,18,16">
                <!-- Ready / downloading controls -->
                <StackPanel x:Name="PanelActive" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnStart" Content="Başlat" Width="96" Height="34" Margin="0,0,8,0"
                            Cursor="Hand" Click="BtnStart_Click" FontWeight="SemiBold"
                            Background="#FF6B00" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnPause" Content="Duraklat" Width="96" Height="34" Margin="0,0,8,0"
                            Cursor="Hand" Click="BtnPause_Click" IsEnabled="False" FontWeight="SemiBold"
                            Background="#2D2D2D" Foreground="#EEE" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnCancelDl" Content="İptal" Width="88" Height="34"
                            Cursor="Hand" Click="BtnCancelDl_Click" IsEnabled="False" FontWeight="SemiBold"
                            Background="#3A1C1C" Foreground="#FF6B6B" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Completed controls -->
                <StackPanel x:Name="PanelDone" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Dosyayı aç" Width="100" Height="34" Margin="0,0,8,0"
                            Cursor="Hand" Click="BtnOpenFile_Click" FontWeight="SemiBold"
                            Background="#FF6B00" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Klasörü aç" Width="100" Height="34" Margin="0,0,8,0"
                            Cursor="Hand" Click="BtnOpenFolder_Click" FontWeight="SemiBold"
                            Background="#2D2D2D" Foreground="#EEE" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Sil" Width="72" Height="34" Margin="0,0,8,0"
                            Cursor="Hand" Click="BtnDelete_Click" FontWeight="SemiBold"
                            Background="#3A1C1C" Foreground="#FF6B6B" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Kapat" Width="72" Height="34"
                            Cursor="Hand" Click="BtnClose_Click" FontWeight="SemiBold"
                            Background="#2D2D2D" Foreground="#EEE" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
