<Window x:Class="DownloadMuck.DownloadSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İndirme" Width="420" SizeToContent="Height"
        MinHeight="260" MaxHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI" ShowInTaskbar="True"
        Topmost="False" ShowActivated="True"
        Icon="pack://application:,,,/Assets/mdm.ico">

    <Grid>
        <Border x:Name="SessionChrome" Background="#1B1B1B" BorderBrush="#333333" BorderThickness="1"
                CornerRadius="14" ClipToBounds="True" SizeChanged="SessionChrome_SizeChanged"
                Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="SessionTitleBar" Grid.Row="0" Background="#222222" CornerRadius="14,14,0,0" ClipToBounds="True"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <Grid Margin="12,0,40,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtTitleFile" Text="İndirme" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#F0F0F0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtTitlePercent" Grid.Column="1" Text="" FontWeight="SemiBold"
                                       FontSize="12" Foreground="#FF6B00" VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                        <Button HorizontalAlignment="Right" Width="34" Height="34" Content="✕"
                                Cursor="Hand" Click="BtnClose_Click" FontSize="11"
                                Foreground="#888888" BorderThickness="0" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#00000000" CornerRadius="0,13,0,0" ClipToBounds="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#E53935" Duration="0:0:0.16"/>
                                                    <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                                                    To="#FFFFFF" Duration="0:0:0.16"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#00000000" Duration="0:0:0.16"/>
                                                    <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                                                    To="#888888" Duration="0:0:0.16"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="12,8,12,4">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.05*"/>
                        </Grid.ColumnDefinitions>

                        <Image x:Name="ImgIcon" Width="26" Height="26" Margin="0,2,8,0" VerticalAlignment="Top"/>

                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtFileName" Text="dosya" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#EEEEEE" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                            <TextBlock x:Name="TxtFileType" Text="" FontSize="10" Foreground="#888888" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock Text="Adres" FontSize="9" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtUrl" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontSize="10" Height="26" VerticalContentAlignment="Center"
                                     Background="#252525" Foreground="#999999" BorderBrush="#333" BorderThickness="1">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="6,0" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Kayıt klasörü" FontSize="9" Foreground="#666" Margin="0,0,0,2"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TxtFolder" FontSize="11" Height="28" VerticalContentAlignment="Center"
                                 Background="#252525" Foreground="White" BorderBrush="#333" BorderThickness="1">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <!-- Renkler ApplyThemeSurface ile güncellenir; sadece opacity -->
                                            <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button Grid.Column="1" x:Name="BtnBrowse" Content="Gözat" Margin="6,0,0,0" Width="68" Height="28"
                                Cursor="Hand" Click="BtnBrowse_Click" FontSize="11" FontWeight="SemiBold"
                                Foreground="#E0E0E0" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2D2D2D" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#222222"/>
                                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                            <Setter Property="Foreground" Value="#666"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsEnabled" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="Background" Value="#3D3D3D"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" x:Name="BtnMoveFile" Content="↕"
                                Width="28" Height="18" Margin="6,4,0,0" HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Cursor="SizeAll" PreviewMouseLeftButtonDown="BtnMoveFile_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="BtnMoveFile_PreviewMouseMove"
                                FontSize="10" Foreground="#777" BorderThickness="0" Padding="0"
                                ToolTip="Basılı tutup sürükleyerek taşı">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2A2A2A"/>
                                            <Setter Property="Foreground" Value="#BBB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Boyut" FontSize="9" Foreground="#666"/>
                            <TextBlock x:Name="TxtSize" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#DDD" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Hız" FontSize="9" Foreground="#666"/>
                            <TextBlock x:Name="TxtSpeed" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#DDD" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TxtStatus" Text="" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,5"
                               Visibility="Collapsed"/>
                    <ProgressBar x:Name="BarProgress" Height="7" Minimum="0" Maximum="100" Value="0"
                                 Background="#2A2A2A" Foreground="#FF6B00" BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                    <Border x:Name="PART_Track"/>
                                    <Grid x:Name="PART_Indicator" ClipToBounds="True" HorizontalAlignment="Left">
                                        <Border Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                                    </Grid>
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock x:Name="TxtPercent" Text="%0" FontSize="10" Foreground="#777" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="12,2,12,10">
                    <StackPanel x:Name="PanelActive" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnStart" Content="Başlat" Width="84" Height="30" Margin="0,0,6,0"
                                Cursor="Hand" Click="BtnStart_Click" FontWeight="SemiBold" FontSize="12"
                                Foreground="White" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#FF6B00" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#3A2A18"/>
                                            <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                                            <Setter Property="Foreground" Value="#777"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsEnabled" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnPause" Content="Duraklat" Width="84" Height="30" Margin="0,0,6,0"
                                Cursor="Hand" Click="BtnPause_Click" IsEnabled="False" FontWeight="SemiBold" FontSize="12"
                                Foreground="#EEE" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2D2D2D" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                                            <Setter Property="Foreground" Value="#777"/>
                                        </Trigger>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#404040" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#2D2D2D" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnCancelDl" Content="İptal" Width="76" Height="30"
                                Cursor="Hand" Click="BtnCancelDl_Click" IsEnabled="True" FontWeight="SemiBold" FontSize="12"
                                Foreground="#FF6B6B" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#3A1C1C" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#5A2828" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#3A1C1C" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PanelDone" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button Content="Dosyayı aç" Width="88" Height="30" Margin="0,0,6,0"
                                Cursor="Hand" Click="BtnOpenFile_Click" FontWeight="SemiBold" FontSize="12"
                                Background="#FF6B00" Foreground="White" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#FF6B00" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Klasör" Width="70" Height="30" Margin="0,0,6,0"
                                Cursor="Hand" Click="BtnOpenFolder_Click" FontWeight="SemiBold" FontSize="12"
                                Foreground="#EEE" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2D2D2D" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#404040"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Sil" Width="60" Height="30" Margin="0,0,6,0"
                                Cursor="Hand" Click="BtnDelete_Click" FontWeight="SemiBold" FontSize="12"
                                Foreground="#FF6B6B" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#3A1C1C" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#5A2828"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Kapat" Width="60" Height="30"
                                Cursor="Hand" Click="BtnClose_Click" FontWeight="SemiBold" FontSize="12"
                                Foreground="#EEE" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2D2D2D" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#404040"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Torrent indirme türü seçimi -->
        <Border x:Name="TorrentPickOverlay" Visibility="Collapsed" Background="#CC000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border x:Name="TorrentPickCard" Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1"
                    CornerRadius="12" Padding="16" MaxWidth="360" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtTorrentPickTitle" Text="İndirme türü" FontWeight="SemiBold" FontSize="14"
                               Foreground="#F0F0F0" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtTorrentPickHint" Text="Bu torrent için ne indirmek istiyorsunuz?"
                               FontSize="12" Foreground="#999" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <RadioButton x:Name="RbTorrentFile" GroupName="TorrentMode" Margin="0,0,0,4"
                                 Foreground="#E0E0E0" FontSize="12" Cursor="Hand">
                        <StackPanel>
                            <TextBlock x:Name="TxtRbTorrentFile" Text="Torrent dosyası (.torrent)" FontSize="12"/>
                            <TextBlock x:Name="TxtTorrentFileSize" Text="" FontSize="11" Foreground="#888" Margin="16,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbFullContent" GroupName="TorrentMode" IsChecked="True" Margin="0,8,0,0"
                                 Foreground="#E0E0E0" FontSize="12" Cursor="Hand">
                        <StackPanel>
                            <TextBlock x:Name="TxtRbFullContent" Text="Tam içerik" FontSize="12"/>
                            <TextBlock x:Name="TxtFullContentSize" Text="" FontSize="11" Foreground="#888" Margin="16,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <Button x:Name="BtnTorrentPickOk" Content="Devam" MinWidth="96" Height="32" Margin="0,16,0,0"
                            HorizontalAlignment="Right" Cursor="Hand" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="12" Click="BtnTorrentPickOk_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#FF6B00" CornerRadius="8" Padding="14,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
