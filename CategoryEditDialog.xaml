<UserControl x:Class="MDM.CategoryEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FocusManager.FocusedElement="{Binding ElementName=TxtName}">
    <Border x:Name="DlgChrome" Background="#1B1B1B" BorderBrush="#333" BorderThickness="1" CornerRadius="12" Width="400">
        <Grid Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtTitle" Text="Kategori düzenle" FontWeight="SemiBold" FontSize="14"
                       Foreground="#EEE" Margin="0,0,0,12"/>

            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                <Button x:Name="BtnResetName" DockPanel.Dock="Right" Content="Varsayılana dön"
                        Click="BtnResetName_Click" Cursor="Hand" FontSize="11" Padding="8,4"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="LblName" Text="Kategori adı" Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Grid.Row="2">
                <TextBox x:Name="TxtName" Height="34" FontSize="13"
                         Background="#252525" Foreground="White" BorderBrush="#333" BorderThickness="1"
                         VerticalContentAlignment="Center" Padding="8,0" KeyDown="TxtName_KeyDown"
                         TextChanged="TxtName_TextChanged">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <TextBlock x:Name="TxtNamePlaceholder" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="16,0,8,0" FontSize="13"
                           Visibility="Collapsed"/>
            </Grid>

            <DockPanel Grid.Row="3" Margin="0,14,0,8">
                <Button x:Name="BtnResetIcon" DockPanel.Dock="Right" Content="Varsayılana dön"
                        Click="BtnResetIcon_Click" Cursor="Hand" FontSize="11" Padding="8,4"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="LblIcon" Text="Simge" Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>

            <Border x:Name="IconListBorder" Grid.Row="4" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                    CornerRadius="10" Padding="10" MaxHeight="140">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="IconPanel"/>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnCancel" Content="İptal" MinWidth="84" Height="32" Margin="0,0,8,0" Padding="14,0"
                        Click="BtnCancel_Click" Cursor="Hand" Foreground="#CCC" BorderThickness="0" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2D2D2D" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnSave" Content="Kaydet" MinWidth="84" Height="32" Padding="14,0" Click="BtnSave_Click"
                        Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#FF6B00" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
