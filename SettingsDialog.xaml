<UserControl x:Class="MDM.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             PreviewKeyDown="SettingsDialog_PreviewKeyDown">

    <UserControl.Resources>
        <SolidColorBrush x:Key="NavTextBrush" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="NavHoverBrush" Color="#FF6B00"/>
        <SolidColorBrush x:Key="NavHoverBgBrush" Color="#00000000"/>
        <SolidColorBrush x:Key="NavSelectedBgBrush" Color="#252525"/>
        <SolidColorBrush x:Key="CheckBoxIdleBgBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="CheckBoxIdleBorderBrush" Color="#555555"/>
        <SolidColorBrush x:Key="SoftBtnBgBrush" Color="#252525"/>
        <SolidColorBrush x:Key="SoftBtnHoverBgBrush" Color="#333333"/>
        <SolidColorBrush x:Key="SoftBtnFgBrush" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="SettingsPanelBgBrush" Color="#141414"/>
        <SolidColorBrush x:Key="SettingsPanelBorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="SettingsMutedBrush" Color="#777777"/>
        <SolidColorBrush x:Key="SettingsLabelBrush" Color="#BBBBBB"/>
        <SolidColorBrush x:Key="SettingsBodyBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SettingsInputBgBrush" Color="#252525"/>
        <SolidColorBrush x:Key="SettingsInputBorderBrush" Color="#333333"/>
        <SolidColorBrush x:Key="BrowserCardBgBrush" Color="#141414"/>
        <SolidColorBrush x:Key="BrowserCardBorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrowserCardTextBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="BrowserCardMutedBrush" Color="#888888"/>
        <SolidColorBrush x:Key="BrowserPillIdleBgBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrowserPillIdleFgBrush" Color="#999999"/>
        <SolidColorBrush x:Key="BrowserPillActiveBgBrush" Color="#1B3A24"/>
        <SolidColorBrush x:Key="BrowserPillActiveFgBrush" Color="#8BC34A"/>

        <Style x:Key="SettingsNavButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource NavHoverBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSelectedBgBrush}"/>
                                <Setter Property="Foreground" Value="#FF6B00"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource NavHoverBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSelectedBgBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SoftBtnFgBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource SoftBtnBgBrush}" CornerRadius="8" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SoftBtnHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsBodyBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource SettingsInputBgBrush}"
                                                BorderBrush="{DynamicResource SettingsInputBorderBrush}" BorderThickness="1"
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="12,0,4,0"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{DynamicResource SettingsBodyBrush}"
                                                                  RecognizesAccessKey="True"/>
                                                <Path Grid.Column="1" Data="M0,0 L5,5 L10,0" Stroke="#FF6B00" StrokeThickness="1.6"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF6B00"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF6B00"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Margin="0,6,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#1C1C1C" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="10"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E8E8E8"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2A2A2A"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#33240F"/>
                                            <Setter Property="Foreground" Value="#FF6B00"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ortak modern tik (App.xaml) -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernLabeledCheckBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SettingsBodyBrush}"/>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SettingsInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#3D4F66"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="620" Height="420" MaxWidth="680" MaxHeight="520"
          UseLayoutRounding="True" SnapsToDevicePixels="True"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Border x:Name="SettingsCard" Background="#1B1B1B" BorderBrush="#333" BorderThickness="1" CornerRadius="14"
                UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="SettingsHeader" Background="#1F1F1F" CornerRadius="14,14,0,0">
                <Grid>
                    <TextBlock x:Name="SettingsTitle" Text="Ayarlar" Margin="16,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0"
                               TextOptions.TextFormattingMode="Display"/>
                    <Button HorizontalAlignment="Right" Width="40" Height="38" Content="✕" Click="BtnCancel_Click"
                            Foreground="#AAA" BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,13,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SettingsNavPane" Background="#161616" BorderBrush="#262626" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0" CanContentScroll="False">
                    <StackPanel Margin="10,10,10,12">
                        <RadioButton x:Name="NavGeneral" Content="Genel" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}" IsChecked="True"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNotifications" Content="Bildirimler" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTheme" Content="Görünüm" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavExtension" Content="Tarayıcı eklentisi" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavKeyboard" Content="Klavye ayarları" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAdvanced" Content="Gelişmiş" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSecurity" Content="Güvenlik" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLanguage" Content="Dil" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavUpdate" Content="Güncelleme" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAbout" Content="Hakkında" GroupName="SettingsNav"
                                     Style="{StaticResource SettingsNavButton}"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1" Margin="16,14,16,8">
                    <ScrollViewer x:Name="PanelGeneral" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TxtGenFolderLabel" Text="Varsayılan indirme klasörü" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFolder" Height="32" FontSize="11" Style="{StaticResource SettingsTextBox}"
                                         Padding="10,0"/>
                                <Button x:Name="BtnGenBrowse" Grid.Column="1" Content="Gözat" Width="68" Height="32" Margin="8,0,0,0"
                                        Click="BtnBrowse_Click" Style="{StaticResource SoftButton}"/>
                            </Grid>

                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAutoStart" Content="Windows ile birlikte başlat"
                                              Margin="0,0,0,10"
                                              Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                                    <CheckBox x:Name="ChkAutoStartMin" Content="Başlangıçta arka planda aç"
                                              Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkDeleteFromDisk" Content="Silince dosyayı bilgisayardan da kaldır"/>
                                    <TextBlock x:Name="TxtGenDeleteHint" Text="Kapalıysa öğe yalnızca listeden çıkar; indirme klasöründeki dosya durur."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,6,0,0"/>
                                    <CheckBox x:Name="ChkAutoExtract" Content="Arşivi indirdikten sonra aç"
                                              Margin="0,12,0,0"/>
                                    <CheckBox x:Name="ChkDeleteArchive" Content="Kapattıktan sonra arşiv dosyasını sil"
                                              Margin="0,10,0,0"/>
                                    <TextBlock x:Name="TxtGenArchiveHint" Text="Arşiv görüntüleyicide açıldıktan sonra kapatınca .rar/.zip dosyası silinir."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,6,0,0"/>
                                    <CheckBox x:Name="ChkAutoFolders" Content="Kategori klasörlerini otomatik oluştur"
                                              Margin="0,12,0,0"/>
                                    <TextBlock x:Name="TxtGenFoldersHint" Text="Kapalıysa indirmeler doğrudan varsayılan klasöre yazılır; Videolar/Arşivler alt klasörü açılmaz."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PanelNotifications" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtNotifyTitle" Text="Bildirimler" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkNotifyTray" Content="Alta alınca tepsi bildirimi göster"
                                              Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtNotifyTrayHint" Text="Uygulama gizli simgelere indiğinde «arka planda çalışıyor» balonu."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,0,0,12"/>
                                    <CheckBox x:Name="ChkNotifyDone" Content="Dosya indince bildirim göster"/>
                                    <TextBlock x:Name="TxtNotifyDoneHint" Text="İndirme bitince Windows tepsi bildirimi (Windows sesi). Kapalıysa bildirim ve ses gelmez."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,6,0,12"/>

                                    <CheckBox x:Name="ChkGameMode" Content="Oyun modu"/>
                                    <TextBlock x:Name="TxtGameModeHint" Text="Açıkken tam ekran oyun veya sunum sırasında indirme bildirimi, tepsi balonu ve mini indirme penceresi çıkmaz. İndirmeler arka planda sürer. Varsayılan kapalıdır; isteğe bağlı açılır."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PanelTheme" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtThemeTitle" Text="Görünüm" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtThemeAppearance" Text="Tema" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <RadioButton x:Name="ThemeDark" GroupName="ThemePick" Margin="0,0,8,0"
                                                     Cursor="Hand" Checked="ThemePick_Changed">
                                            <RadioButton.Content>
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtThemeDark" Text="Koyu" Foreground="#F0F0F0" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeDarkSub" Text="Siyah mod" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </RadioButton.Content>
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="#121212" BorderBrush="Transparent" BorderThickness="0"
                                                            CornerRadius="12" Padding="14" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#FF6B00"/>
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsChecked" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#666"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton x:Name="ThemeLight" GroupName="ThemePick" Margin="8,0,0,0"
                                                     Cursor="Hand" Checked="ThemePick_Changed">
                                            <RadioButton.Content>
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtThemeLight" Text="Açık" Foreground="#1A1A1A" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtThemeLightSub" Text="Beyaz mod" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </RadioButton.Content>
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="#F4F4F6" BorderBrush="Transparent" BorderThickness="0"
                                                            CornerRadius="12" Padding="14" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#FF6B00"/>
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsChecked" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#AAA"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </UniformGrid>
                                    <Border x:Name="LightBrightnessPanel" Visibility="Collapsed" Margin="0,12,0,0"
                                            Background="{DynamicResource SettingsPanelBgBrush}"
                                            BorderBrush="{DynamicResource SettingsInputBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock x:Name="TxtBrightnessLabel" Text="Beyaz ton parlaklığı" Foreground="{DynamicResource SettingsLabelBrush}"
                                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtLightBrightnessValue" Text="100%" Foreground="{DynamicResource SettingsBodyBrush}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SldLightBrightness" Minimum="70" Maximum="100" Value="100"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" Height="22"
                                                    Foreground="#FF6B00"
                                                    ValueChanged="LightBrightness_Changed"/>
                                            <TextBlock x:Name="TxtBrightnessHint" Text="Yalnızca yüzeyleri etkiler (ana pencere ve popup'lar). Yazılar tam kontrastta kalır."
                                                       Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtThemeHint" Text="Seçince anında önizlenir. Kalıcı olması için Kaydet’e basın; İptal eski temaya döner."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <CheckBox x:Name="ChkSidebarCollapse" Content="Kategori kenar çubuğunu daralt"
                                              Margin="0,16,0,0" Cursor="Hand"
                                              Checked="SidebarCollapse_Changed" Unchecked="SidebarCollapse_Changed"/>
                                    <TextBlock x:Name="TxtSidebarCollapseHint" Text="Açıkken sol üstteki ‹ düğmesi kenar çubuğunu yalnızca simgelere küçültür. Kapalıysa düğme gizlenir."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PanelExtension" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtExtPanelTitle" Text="Eklenti denetimi" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <StackPanel x:Name="BrowserStatusList" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="BtnRefreshBrowsers" Content="Yenile" Margin="0,0,8,0"
                                        Click="BtnRefreshBrowsers_Click" Style="{StaticResource SoftButton}"/>
                                <Button x:Name="BtnExtHowto" Content="Kurulum nasıl yapılır?" Margin="0,0,8,0"
                                        Click="BtnExtHowto_Click" Style="{StaticResource SoftButton}"/>
                                <Button x:Name="BtnInstallFirefox" Content="Firefox otomatik kur"
                                        Click="BtnInstallFirefox_Click" Style="{StaticResource SoftButton}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtExtFolderLabel" Text="Eklenti klasörü" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <TextBlock x:Name="TxtExtPath" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnExtCleanup" Content="Kalıntı temizle" Margin="0,0,8,0"
                                        Click="BtnReinstallExt_Click" Style="{StaticResource SoftButton}"/>
                                <Button x:Name="BtnExtOpenFolder" Content="Klasörü aç"
                                        Click="BtnOpenExtFolder_Click" Style="{StaticResource SoftButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PanelKeyboard" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtKeyboardTitle" Text="Uygulama içi kısayollar" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCopyHotkey" Content="Seçili dosyaları panoya kopyala"
                                              Margin="0,0,0,8"
                                              Checked="ChkCopyHotkey_Changed" Unchecked="ChkCopyHotkey_Changed"/>
                                    <TextBlock x:Name="TxtKeyCopyHint" Text="Etkinse seçili tamamlanmış indirmeleri panoya dosya olarak koyar; Explorer veya başka uygulamaya Ctrl+V ile yapıştırabilirsiniz."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,0,0,14"/>
                                    <TextBlock x:Name="TxtKeyShortcutLabel" Text="Kısayol" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="HotkeyBox" Background="{DynamicResource SettingsInputBgBrush}" BorderBrush="{DynamicResource SettingsInputBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Height="34" Padding="12,0" VerticalAlignment="Center"
                                                Focusable="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                MouseLeftButtonDown="HotkeyBox_MouseLeftButtonDown">
                                            <TextBlock x:Name="TxtHotkey" Text="Ctrl+C" Foreground="{DynamicResource SettingsBodyBrush}"
                                                       FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                        <Button x:Name="BtnCaptureHotkey" Grid.Column="1" Content="Değiştir" Width="78" Height="34" Margin="8,0,0,0"
                                                Click="BtnCaptureHotkey_Click" Style="{StaticResource SoftButton}"/>
                                        <Button x:Name="BtnResetHotkey" Grid.Column="2" Content="Sıfırla" Width="68" Height="34" Margin="8,0,0,0"
                                                Click="BtnResetHotkey_Click" Style="{StaticResource SoftButton}"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtHotkeyHint" Text="Kısayolu değiştirmek için «Değiştir»e basın, sonra tuşlara basın."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>

                                    <CheckBox x:Name="ChkDeleteKey" Content="Delete tuşu uygulama içi kısayol silmeye izin ver"
                                              Margin="0,18,0,0"/>
                                    <TextBlock x:Name="TxtKeyDeleteHint" Text="Etkinse Delete tuşu seçili dosyaları, arşivleri ve kategorileri siler."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PanelAdvanced" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtAdvTitle" Text="Zamanlayıcı ve uzak denetim" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSchedule" Content="Yalnızca bu saatler arasında indir"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock x:Name="TxtAdvSchedStartLabel" Text="Başlangıç saati" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtSchedStart" Width="40" Height="28" Text="0"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                        <TextBlock x:Name="TxtAdvSchedEndLabel" Text="Bitiş" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                        <TextBox x:Name="TxtSchedEnd" Width="40" Height="28" Text="0"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAdvSchedHint" Text="Aynı saat = her zaman açık. 22 ve 6 gece penceresidir."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                    <TextBlock x:Name="TxtAdvCrawlLabel" Text="Tarama derinliği (0–3)" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtCrawlDepth" Width="40" Height="28" HorizontalAlignment="Left" Text="1"
                                             Style="{StaticResource SettingsTextBox}" Padding="6,0"/>
                                    <CheckBox x:Name="ChkRemoteLan" Content="REST API’yi LAN’dan dinle (token gerekir)"
                                              Margin="0,14,0,8"/>
                                    <TextBlock x:Name="TxtAdvApiTokenLabel" Text="API token" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtApiToken" Height="28" Style="{StaticResource SettingsTextBox}"/>
                                    <CheckBox x:Name="ChkHttp3" Content="HTTPS’te HTTP/3 dene (olmazsa 2 / 1.1)"
                                              Margin="0,14,0,8"/>
                                    <CheckBox x:Name="ChkAutoReconnect" Content="Ağ düşünce otomatik devam et"
                                              Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <TextBlock x:Name="TxtAdvSpeedLabel" Text="Hız limiti KB/s" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtSpeedLimit" Width="56" Height="28" Text="0"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                        <TextBlock x:Name="TxtAdvSpeedHint" Text="(0 = sınırsız)" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtAdvConcurrentLabel" Text="Eşzamanlı indirme" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtMaxConcurrent" Width="40" Height="28" Text="0"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                        <TextBlock x:Name="TxtAdvConcurrentHint" Text="(0 = sınırsız, fazlası kuyruk)" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtAdvHttpChannelsLabel" Text="HTTP kanal (0=otomatik)" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtHttpChannels" Width="40" Height="28" Text="0"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAdvTorrentTitle" Text="Torrent" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,8,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtAdvTorrentPortLabel" Text="Dinleme portu" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtTorrentPort" Width="56" Height="28" Text="6881"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkTorrentDht" Content="DHT (trackersız magnet)"
                                              Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkTorrentLpd" Content="Yerel eş keşfi"
                                              Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkTorrentUpnp" Content="UPnP / NAT-PMP port yönlendirme"
                                              Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkTorrentSeq" Content="Sıralı indir (önce ilk dosya)"
                                              Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtAdvSeedLabel" Text="Paylaşım oranı" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtTorrentSeed" Width="48" Height="28" Text="0"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                        <TextBlock x:Name="TxtAdvSeedHint" Text="(0 = indince dur)" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkSkipDup" Content="Aynı URL’yi ikinci kez ekleme"
                                              Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtAdvSkipExtLabel" Text="Atlanan uzantılar (virgülle)" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,4,0,6"/>
                                    <TextBox x:Name="TxtSkipExt" Height="28" Style="{StaticResource SettingsTextBox}"
                                             ToolTip="Örn: exe, scr, bat"/>
                                    <TextBlock x:Name="TxtAdvSkipUrlLabel" Text="URL’de geçenleri atla" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,8,0,6"/>
                                    <TextBox x:Name="TxtSkipUrl" Height="28" Style="{StaticResource SettingsTextBox}"/>
                                    <TextBlock x:Name="TxtAdvSkipDomainsLabel" Text="Atlanan alan adları (virgülle)" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,8,0,6"/>
                                    <TextBox x:Name="TxtSkipDomains" Height="28" Style="{StaticResource SettingsTextBox}"
                                             ToolTip="Örn: ads.example.com, tracker.net"/>
                                    <TextBlock x:Name="TxtAdvSkipRegexLabel" Text="URL regex (boş = kapalı)" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,8,0,6"/>
                                    <TextBox x:Name="TxtSkipRegex" Height="28" Style="{StaticResource SettingsTextBox}"/>
                                    <TextBlock x:Name="TxtAdvSkipMimeLabel" Text="Atlanan MIME (virgülle, örn: video/, audio/)" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,8,0,6"/>
                                    <TextBox x:Name="TxtSkipMime" Height="28" Style="{StaticResource SettingsTextBox}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                        <TextBlock x:Name="TxtAdvMinMbLabel" Text="Min MB" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtSkipMinMb" Width="48" Height="28" Text="0"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                        <TextBlock x:Name="TxtAdvMaxMbLabel" Text="Max MB" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                        <TextBox x:Name="TxtSkipMaxMb" Width="48" Height="28" Text="0"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                        <TextBlock x:Name="TxtAdvSizeHint" Text="(0 = kapalı)" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAdvRenameLabel" Text="Yeniden adlandır {name} {ext} {date} {host}" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,8,0,6"/>
                                    <TextBox x:Name="TxtRename" Height="28" Style="{StaticResource SettingsTextBox}"/>
                                    <TextBlock x:Name="TxtAdvCliHint" Text="CLI: download URL  |  --add URL  |  --grab SAYFA  |  --list  |  --pause|--resume|--cancel ID"
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,8"/>
                                    <Border Background="{DynamicResource SettingsPanelBorderBrush}" Height="1"
                                            Margin="0,12,0,12" Opacity="0.6"/>
                                    <TextBlock x:Name="TxtAdvResetTitle" Text="Gelişmiş ayarları varsayılana döndür"
                                               Foreground="{DynamicResource SettingsBodyBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtAdvResetHint" Margin="0,5,0,0" TextWrapping="Wrap"
                                               Text="Bu bölümdeki tüm alanlar kurulumdaki haline döner. Diğer ayarlar etkilenmez."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11"/>
                                    <Button x:Name="BtnAdvReset" Content="Varsayılana döndür" Height="30" Width="160"
                                            Margin="0,10,0,0" HorizontalAlignment="Left" Click="BtnAdvReset_Click"
                                            Style="{StaticResource SoftButton}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PanelSecurity" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtSecurityTitle" Text="Güvenlik" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkConfirmRepeat" Content="İndirme spam’inde güvenlik onayı (önerilir)"
                                              Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtSecurityHint" Text="Açıkken kısa sürede aynı bağlantıya veya toplu indirme isteklerine karşı tek bir onay penceresi gösterilir. Onaylamazsanız istekler sessizce engellenir; normal indirmeleri etkilemez."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,0,0,0"/>

                                    <Border Background="{DynamicResource SettingsPanelBorderBrush}" Height="1" Margin="0,12,0,12" Opacity="0.6"/>

                                    <CheckBox x:Name="ChkWarnDangerous" Content="Zararlı olabilecek dosyalarda izin sor (önerilir)"
                                              Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtDangerousHint" Text="Program, betik veya makro içeren dosyalar indirilmeden önce tarayıcıdaki gibi bir izin penceresi gösterilir. İzin vermezseniz indirme başlamaz."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,0,0,0"/>

                                    <CheckBox x:Name="ChkMarkFromInternet" Content="İndirilen dosyaları “internetten geldi” olarak işaretle"
                                              Margin="0,14,0,8"/>
                                    <TextBlock x:Name="TxtMarkHint" Text="Windows ve Microsoft Defender dosyayı açarken kendi güvenlik denetimini uygular. Kapatırsanız bu uyarılar çıkmaz."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="28,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PanelLanguage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtLanguageTitle" Text="Uygulama dili" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <ComboBox x:Name="CmbLanguage" Style="{StaticResource SettingsComboBox}"
                                              SelectionChanged="CmbLanguage_SelectionChanged"/>
                                    <TextBlock x:Name="TxtLanguageHint" Text="Dil değişikliği uygulama arayüzüne ve tarayıcı eklentisine uygulanır."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PanelUpdate" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtUpdateTitle" Text="Uygulama güncellemesi" Foreground="{DynamicResource SettingsLabelBrush}" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtUpdateCurrent" Foreground="{DynamicResource SettingsBodyBrush}" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtUpdateHint" Text="Güncelleme yalnızca buradan denetlenir; uygulama her açılışta otomatik aramaz."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button x:Name="BtnCheckUpdate" Content="Güncellemeyi denetle" HorizontalAlignment="Left"
                                            MinWidth="160" Height="32" Click="BtnCheckUpdate_Click"
                                            Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#FF6B00" CornerRadius="8" Padding="14,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                                        <Setter Property="Foreground" Value="#888"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock x:Name="TxtUpdateStatus" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,10,0,0" MinHeight="18"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PanelAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Image Source="pack://application:,,,/Assets/mdm-logo.png" Width="36" Height="36"
                                               Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtAboutName" Text="MuckDownloadManager" Foreground="{DynamicResource SettingsBodyBrush}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="TxtVersion" Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAboutDesc" Text="İndirmeleri kategorilere ayıran, tarayıcı yakalamalı masaüstü yöneticisi."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Yalnızca setup ile kurulduysa görünür -->
                            <Border x:Name="CardUninstall" Visibility="Collapsed" Margin="0,12,0,0"
                                    Background="{DynamicResource SettingsPanelBgBrush}" BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="TxtUninstallTitle" Text="Uygulamayı kaldır"
                                               Foreground="{DynamicResource SettingsBodyBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtUninstallHint" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="MuckDownloadManager bilgisayarınızdan kaldırılır. İndirdiğiniz dosyalar silinmez."
                                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="11"/>
                                    <Button x:Name="BtnUninstallApp" Content="Kaldır" Width="120" Height="32"
                                            Margin="0,12,0,0" HorizontalAlignment="Left" Click="BtnUninstallApp_Click"
                                            Style="{StaticResource SoftButton}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border x:Name="SettingsFooter" Grid.Row="2" Background="#1A1A1A" BorderBrush="#262626" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancelSettings" Content="İptal" Width="84" Height="32" Margin="0,0,8,0" Click="BtnCancel_Click"
                            Style="{StaticResource SoftButton}"/>
                    <Button x:Name="BtnSaveSettings" Content="Kaydet" Width="84" Height="32" Click="BtnSave_Click"
                            Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#FF6B00" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        </Border>
    </Grid>
</UserControl>
