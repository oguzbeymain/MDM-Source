<Window x:Class="DownloadMuck.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar" Width="460" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI" ShowInTaskbar="False">

    <Border Background="#1B1B1B" BorderBrush="#333" BorderThickness="1" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="#000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#222" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="Ayarlar" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12" Foreground="#EEE"/>
                    <Button HorizontalAlignment="Right" Width="36" Height="34" Content="✕" Click="BtnCancel_Click"
                            Foreground="#AAA" BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,11,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,8">
                <StackPanel>
                    <!-- Genel -->
                    <TextBlock Text="GENEL" Foreground="#FF6B00" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Varsayılan indirme klasörü" Foreground="#CCC" FontSize="11" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFolder" Height="30" FontSize="11" VerticalContentAlignment="Center"
                                         Background="#252525" Foreground="White" BorderBrush="#333" BorderThickness="1"
                                         Padding="8,0"/>
                                <Button Grid.Column="1" Content="Gözat" Width="64" Height="30" Margin="8,0,0,0"
                                        Click="BtnBrowse_Click" Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="11">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#2A2A2A" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <CheckBox x:Name="ChkAutoStart" Content="Windows ile birlikte başlat"
                                      Foreground="#DDD" FontSize="12" Margin="0,0,0,8" Cursor="Hand"
                                      Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                            <CheckBox x:Name="ChkAutoStartMin" Content="Başlangıçta arka planda (görev çubuğunda) aç"
                                      Foreground="#DDD" FontSize="12" Margin="18,0,0,0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Eklenti -->
                    <TextBlock Text="TARAYICI EKLENTİSİ" Foreground="#FF6B00" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="TxtExtPath" Foreground="#999" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Kalıntı temizle" Height="30" Padding="12,0" Margin="0,0,8,0"
                                        Click="BtnReinstallExt_Click" Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="11">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#2A2A2A" CornerRadius="8" Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="Klasörü aç" Height="30" Padding="12,0"
                                        Click="BtnOpenExtFolder_Click" Cursor="Hand" Foreground="#CCC" BorderThickness="0" FontSize="11">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#252525" CornerRadius="8" Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hakkinda -->
                    <TextBlock Text="HAKKINDA" Foreground="#FF6B00" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="MuckDownloadManager" Foreground="#EEE" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtVersion" Foreground="#999" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="İndirmeleri kategorilere ayıran, tarayıcı yakalamalı masaüstü yöneticisi."
                                       Foreground="#777" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,8,14,14">
                <Button Content="İptal" Width="78" Height="30" Margin="0,0,8,0" Click="BtnCancel_Click"
                        Cursor="Hand" Foreground="#CCC" BorderThickness="0" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#2D2D2D" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Kaydet" Width="78" Height="30" Click="BtnSave_Click"
                        Cursor="Hand" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#FF6B00" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF8533"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
